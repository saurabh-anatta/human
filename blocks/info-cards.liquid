<info-cards-accordion
  class="info-cards-block{% unless block.settings.show_index %} info-cards--hide-index{% endunless %}"
  id="info-cards-block-{{ block.id }}"
  style="--info-cards-radius-desktop: {{ block.settings.border_radius_desktop }}px; --info-cards-radius-mobile: {{ block.settings.border_radius_mobile }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</info-cards-accordion>

<script src="{{ 'info-cards-accordion.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  info-cards-accordion {
    display: block;
    counter-reset: info-card-index;
  }

  .info-cards--hide-index .info-card-index {
    display: none !important;
  }

  .info-card-content__inner {
    overflow: hidden;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  @media screen and (max-width: 749px) {
    info-cards-accordion .custom-grid-column + .custom-grid-column .info-card {
      margin-top: calc(-1 * var(--info-card-padding-block-mobile, 0px) - 4px);
    }

    info-cards-accordion .custom-grid {
      column-gap: 0;
      row-gap: 0;
    }

    info-cards-accordion .custom-grid-column:not(:last-child) .info-card {
      padding-bottom: calc(var(--info-card-padding-block-mobile, 0px) * 2);
    }

    .info-card-content {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition: grid-template-rows 0.35s ease, opacity 0.3s ease;
    }

    .info-card-content[data-open] {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }

  @media screen and (min-width: 750px) {
    .info-card-content {
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .info-card-content__inner {
      overflow: visible;
      flex: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .info-card-content {
      transition: none;
    }
  }
{% endstylesheet %}

