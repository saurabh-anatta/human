{% doc %}
  Block: Overlay Hotspots

  An absolutely-positioned overlay anchored to its nearest positioned
  ancestor. Drop it inside a Hero (or any container with position) to
  float badges, callouts, or labels at arbitrary x/y coordinates.

  Coordinates are percentages of the parent box. The hotspot is centered
  on the (x, y) point via a translate(-50%, -50%). Desktop and mobile
  positions are set independently.
{% enddoc %}

{% liquid
  assign s = block.settings
%}

{% capture inline_styles %}
  --ovh-x-mobile: {{ s.x_mobile }}%;
  --ovh-y-mobile: {{ s.y_mobile }}%;
  --ovh-x-desktop: {{ s.x_desktop }}%;
  --ovh-y-desktop: {{ s.y_desktop }}%;
{% endcapture %}

{% stylesheet %}
  .overlay-hotspot {
    position: absolute;
    left: var(--ovh-x-mobile);
    top: var(--ovh-y-mobile);
    transform: translate(-50%, -50%);
    z-index: 3;
    pointer-events: auto;
    max-width: 90%;
    width: max-content;
  }

  @media screen and (min-width: 750px) {
    .overlay-hotspot {
      left: var(--ovh-x-desktop);
      top: var(--ovh-y-desktop);
    }
  }
{% endstylesheet %}

<div
  class="overlay-hotspot"
  style="{{ inline_styles | strip_newlines }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
