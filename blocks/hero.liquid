    { "type": "header", "content": "Mobile — Height" },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Height",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "screen", "label": "Screen height" },
        { "value": "full", "label": "Full height (minus header)" },
        { "value": "100", "label": "100%" },
        { "value": "custom", "label": "Custom" }
      ]
    },
    {
      "type": "number",
      "id": "mobile_custom_height",
      "label": "Custom height (px)",
      "default": 480,
      "visible_if": "{{ block.settings.mobile_height == 'custom' }}"
    },

    { "type": "header", "content": "Mobile — Width" },
    {
      "type": "select",
      "id": "mobile_width",
      "label": "Width",
      "default": "100",
      "options": [
        { "value": "100", "label": "100%" },
        { "value": "fit", "label": "Fit content" },
        { "value": "fill", "label": "Fill" },
        { "value": "custom", "label": "Custom" }
      ]
    },
    {
      "type": "number",
      "id": "mobile_custom_width",
      "label": "Custom width (px)",
      "default": 360,
      "visible_if": "{{ block.settings.mobile_width == 'custom' }}"
    },

    { "type": "header", "content": "Mobile — Background" },
    {
