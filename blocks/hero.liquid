      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "desktop_padding_left",
      "label": "Padding left",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "desktop_margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
