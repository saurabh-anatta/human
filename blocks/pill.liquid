{% liquid
  assign s = block.settings

  capture inline_styles
    if s.color_scheme != blank
      echo '--pill-bg: ' | append: s.color_scheme.settings.background | append: ';'
      echo '--pill-color: ' | append: s.color_scheme.settings.foreground | append: ';'
    endif
    echo '--pill-font-family-mobile: ' | append: s.font_family_mobile | append: ';'
    echo '--pill-font-weight-mobile: ' | append: s.font_weight_mobile | append: ';'
    echo '--pill-font-size-mobile: ' | append: s.font_size_mobile | append: ';'
    echo '--pill-line-height-mobile: ' | append: s.line_height_mobile | append: ';'
    echo '--pill-font-family-desktop: ' | append: s.font_family_desktop | append: ';'
    echo '--pill-font-weight-desktop: ' | append: s.font_weight_desktop | append: ';'
    echo '--pill-font-size-desktop: ' | append: s.font_size_desktop | append: ';'
    echo '--pill-line-height-desktop: ' | append: s.line_height_desktop | append: ';'
    echo '--pill-padding-mobile: ' | append: s.padding_top_mobile | append: 'px ' | append: s.padding_right_mobile | append: 'px ' | append: s.padding_bottom_mobile | append: 'px ' | append: s.padding_left_mobile | append: 'px;'
    echo '--pill-padding-desktop: ' | append: s.padding_top_desktop | append: 'px ' | append: s.padding_right_desktop | append: 'px ' | append: s.padding_bottom_desktop | append: 'px ' | append: s.padding_left_desktop | append: 'px;'
    echo '--pill-radius-mobile: ' | append: s.border_radius_mobile | append: 'px;'
    echo '--pill-radius-desktop: ' | append: s.border_radius_desktop | append: 'px;'
  endcapture
%}

{% stylesheet %}
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--pill-bg, transparent);
    color: var(--pill-color, currentColor);
    padding: var(--pill-padding-mobile, 4px 12px);
    font-family: var(--pill-font-family-mobile, inherit);
    font-weight: var(--pill-font-weight-mobile, 400);
    font-size: var(--pill-font-size-mobile, 0.875rem);
    line-height: var(--pill-line-height-mobile, 1.5rem);
    border-radius: var(--pill-radius-mobile, 100px);
  }

  @media screen and (min-width: 750px) {
    .pill {
      padding: var(--pill-padding-desktop, var(--pill-padding-mobile, 4px 12px));
      font-family: var(--pill-font-family-desktop, var(--pill-font-family-mobile, inherit));
      font-weight: var(--pill-font-weight-desktop, var(--pill-font-weight-mobile, 400));
      font-size: var(--pill-font-size-desktop, var(--pill-font-size-mobile, 0.875rem));
      line-height: var(--pill-line-height-desktop, var(--pill-line-height-mobile, 1.5rem));
      border-radius: var(--pill-radius-desktop, var(--pill-radius-mobile, 100px));
    }
  }
{% endstylesheet %}

{%- if s.text != blank -%}
  {%- if s.url != blank -%}
    <a
      href="{{ s.url }}"
      class="pill"
      style="{{ inline_styles }}"
      {{ block.shopify_attributes }}
    >
      {{- s.text -}}
    </a>
  {%- else -%}
    <span
      class="pill"
      style="{{ inline_styles }}"
      {{ block.shopify_attributes }}
    >
      {{- s.text -}}
    </span>
  {%- endif -%}
{%- else -%}
  <span {{ block.shopify_attributes }}></span>
{%- endif -%}

