{% liquid
  assign block_settings = block.settings
%}

{% capture style %}
  --custom-text-font-family: {{ block_settings.font_family }};
  --custom-text-font-family-strong: {{ block_settings.font_family_strong }};
  --custom-text-font-weight: {{ block_settings.font_weight }};
  --custom-text-font-size: {{ block_settings.font_size }};
  --custom-text-line-height: {{ block_settings.line_height }};
  --custom-text-letter-spacing: {{ block_settings.letter_spacing }};
  --custom-text-alignment: {{ block_settings.alignment }};
  --custom-text-color: {{ block_settings.color }};
  --custom-text-transform: {{ block_settings.text_transform }};
  --custom-text-decoration: {{ block_settings.text_decoration }};
  --custom-text-width: {{ block_settings.width }};
  --custom-text-max-width: {{ block_settings.max_width }};
  --custom-text-margin-bottom: {{ block_settings.margin_block_end }}px;

  --custom-text-font-size-mobile: {{ block_settings.font_size_mobile }};
  --custom-text-font-family-mobile: {{ block_settings.font_family_mobile }};
  --custom-text-font-family-strong-mobile: {{ block_settings.font_family_strong_mobile }};
  --custom-text-font-weight-mobile: {{ block_settings.font_weight_mobile }};
  --custom-text-line-height-mobile: {{ block_settings.line_height_mobile }};
  --custom-text-letter-spacing-mobile: {{ block_settings.letter_spacing_mobile }};
  --custom-text-alignment-mobile: {{ block_settings.alignment_mobile }};
  --custom-text-transform-mobile: {{ block_settings.text_transform_mobile }};
  --custom-text-decoration-mobile: {{ block_settings.text_decoration_mobile }};
  --custom-text-width-mobile: {{ block_settings.width_mobile }};
  --custom-text-max-width-mobile: {{ block_settings.max_width_mobile }};
  --custom-text-margin-bottom-mobile: {{ block_settings.margin_block_end_mobile }}px;
  --custom-text-color-mobile: {{ block_settings.color_mobile }};
{% endcapture %}

{% assign style = style | strip_newlines | strip %}
{% render 'custom-text', block: block, block_settings: block_settings, style: style %}

