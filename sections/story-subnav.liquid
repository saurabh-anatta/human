{%- comment -%}
  story-subnav.liquid — Sticky sub-nav capsule for the "Our Story" page.
  First section in template order: loads global story-scroll.css and
  story-utils.js + story-subnav.js immediately (above-the-fold).
{%- endcomment -%}

{%- comment -%} ── Global story CSS (loaded once) ── {%- endcomment -%}
{{ 'story-scroll.css' | asset_url | stylesheet_tag }}

<div class="story-subnav" data-story-subnav>
  <nav class="story-subnav__capsule" aria-label="Story navigation">
    <ul class="story-subnav__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_item' -%}
          <li class="story-subnav__item">
            <a
              class="story-subnav__link"
              href="#{{ block.settings.anchor }}"
              data-anchor="{{ block.settings.anchor }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label -}}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>
</div>

<script type="module">
  (function () {
    const sectionEl = document.querySelector('[data-story-subnav]');
    if (!sectionEl) return;

    Promise.all([
      import('{{ "story-utils.js" | asset_url }}'),
      import('{{ "story-subnav.js" | asset_url }}')
    ]).then(([utils, subnav]) => {
      subnav.init(sectionEl, utils);
    });
  })();
</script>

{% stylesheet %}
/* ==========================================================================
   story-subnav — Sticky capsule nav
   BEM: .story-subnav__, modifier: .story-subnav--stuck
   CSS custom props: --ssn-* (set by JS)
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. Shopify section wrapper — set via schema "class": "story-subnav-section"
   Transparent background avoids base.css .section override; high z-index
   keeps the capsule above story chapters (--story-z: 10, 20, 30 …).
   -------------------------------------------------------------------------- */
.story-subnav-section {
  background: transparent;
  position: relative;
  z-index: 999;
}

/* --------------------------------------------------------------------------
   2. Inner root — centers the capsule in normal flow
   -------------------------------------------------------------------------- */
.story-subnav {
  display: flex;
  justify-content: center;
  padding-block: 12px;
  width: 100%;
}

/* --------------------------------------------------------------------------
   3. Stuck state — position:fixed below the site header
   JS sets --ssn-header-offset to the header height in px.
   The parent .shopify-section gets min-height to prevent layout shift.
   -------------------------------------------------------------------------- */
.story-subnav--stuck {
  position: fixed;
  top: var(--ssn-header-offset, 0px);
  left: 0;
  right: 0;
  z-index: 999;
  padding-block: 12px;
}

/* --------------------------------------------------------------------------
   4. Capsule — the white pill container
   -------------------------------------------------------------------------- */
.story-subnav__capsule {
  display: flex;
  align-items: center;
  width: fit-content;
  max-width: calc(100% - 32px);
  padding: 6px;
  border-radius: 999px;
  background: #FFFFFF;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  transition: box-shadow 0.3s ease;
}

/* Slightly stronger shadow when stuck for visual separation */
.story-subnav--stuck .story-subnav__capsule {
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
}

/* --------------------------------------------------------------------------
   5. List — horizontal scrolling container
   -------------------------------------------------------------------------- */
.story-subnav__list {
  display: flex;
  align-items: center;
  gap: 2px;
  list-style: none;
  margin: 0;
  padding: 0;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.story-subnav__list::-webkit-scrollbar {
  display: none;
}

/* --------------------------------------------------------------------------
   6. List items
   -------------------------------------------------------------------------- */
.story-subnav__item {
  flex-shrink: 0;
}

/* --------------------------------------------------------------------------
   7. Nav links
   -------------------------------------------------------------------------- */
.story-subnav__link {
  display: inline-flex;
  align-items: center;
  padding: 8px 16px;
  border-radius: 999px;
  font-family: var(--os-font-label, sans-serif);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.75px;
  line-height: 1;
  text-transform: uppercase;
  text-decoration: none;
  color: var(--os-color-muted, #767676);
  white-space: nowrap;
  cursor: pointer;
  transition: color 0.25s ease, background-color 0.25s ease;
}

.story-subnav__link:hover {
  color: var(--os-color-dark-text, #414141);
}

/* Active link — red pill with white text */
.story-subnav__link--active {
  background: var(--os-color-red, #BC0F0F);
  color: var(--os-color-white, #FFFFFF);
}

.story-subnav__link--active:hover {
  color: var(--os-color-white, #FFFFFF);
}

/* --------------------------------------------------------------------------
   8. Mobile adjustments
   -------------------------------------------------------------------------- */
@media screen and (max-width: 749px) {
  .story-subnav {
    padding-block: 8px;
  }

  .story-subnav--stuck {
    padding-block: 8px;
  }

  .story-subnav__capsule {
    max-width: calc(100% - 24px);
    padding: 4px;
  }

  .story-subnav__link {
    padding: 6px 12px;
    font-size: 11px;
  }
}

/* --------------------------------------------------------------------------
   9. Reduced motion — disable transitions
   -------------------------------------------------------------------------- */
@media (prefers-reduced-motion: reduce) {
  .story-subnav__capsule,
  .story-subnav__link {
    transition: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Story Sub-Nav",
  "tag": "section",
  "class": "story-subnav-section",
  "limit": 1,
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Nav item",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "SECTION"
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "Anchor slug",
          "info": "Must match the data-anchor on the target story chapter."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Story Sub-Nav",
      "blocks": [
        {
          "type": "nav_item",
          "settings": {
            "label": "HOW IT STARTED",
