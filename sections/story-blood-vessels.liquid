{%- liquid
  assign pin_distance = section.settings.pin_distance | default: 5000
  assign overlap_distance = section.settings.overlap_distance | default: 5000
-%}

{%- capture inline_styles -%}
  --os-chapter-z: 40; margin-top: -{{ overlap_distance }}px;
{%- endcapture -%}

<div
  class="story-chapter story-chapter--overlay"
  data-anchor="blood-vessels"
  style="height: calc(100vh + {{ pin_distance }}px); {{ inline_styles }}"
>
  <div
    class="story-chapter__sticky story-blood-vessels"
    data-section-id="{{ section.id }}"
  >

    <div class="story-blood-vessels__heart-glow" aria-hidden="true"></div>

    <video
      class="story-blood-vessels__video"
      playsinline
      muted
      preload="none"
      {%- if section.settings.fallback_image != blank %}
        poster="{{ section.settings.fallback_image | image_url: width: 1440 }}"
      {%- endif %}
      {%- if section.settings.video_url != blank %}
        src="{{ section.settings.video_url }}"
      {%- endif %}
      aria-hidden="true"
    ></video>

    <canvas class="story-blood-vessels__canvas" aria-hidden="true"></canvas>

    <div class="story-blood-vessels__headline">
      {{ section.settings.headline_text }}
    </div>

    <div class="story-blood-vessels__exit-copy">
      <div class="story-blood-vessels__exit-copy-serif">
        {{ section.settings.exit_copy_serif }}
      </div>
      <div class="story-blood-vessels__exit-divider" aria-hidden="true"></div>
      <div class="story-blood-vessels__exit-copy-bold">
        {{ section.settings.exit_copy_bold }}
      </div>
    </div>

    <div class="story-blood-vessels__scroll-hint">
      <span class="story-blood-vessels__scroll-label">{{ section.settings.hint_label }}</span>
      <span class="story-blood-vessels__scroll-chevron" aria-hidden="true">&#8595;</span>
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'narrative_copy' and block.settings.enabled -%}
        <div class="story-blood-vessels__narrative" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if section.settings.fallback_image != blank -%}
      <div class="story-blood-vessels__fallback">
        {{
          section.settings.fallback_image
          | image_url: width: 1440
          | image_tag:
            widths: '375,750,1100,1440',
            sizes: '100vw',
            alt: 'Blood vessels',
            loading: 'lazy',
            class: 'story-blood-vessels__fallback-img'
        }}
      </div>
    {%- endif -%}

  </div>
</div>

<script type="module">
  (function () {
    var utilsUrl = {{ 'story-utils.js' | asset_url | json }};
    var sectionUrl = {{ 'story-blood-vessels.js' | asset_url | json }};
    var sectionEl = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!sectionEl) return;

    var target = sectionEl.closest('.story-chapter') || sectionEl;
    var observer = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) {
          observer.disconnect();
          Promise.all([import(utilsUrl), import(sectionUrl)]).then(function (modules) {
            var utils = modules[0];
            var section = modules[1];
            section.init(sectionEl, utils);
          });
          break;
        }
      }
    }, { rootMargin: '400px' });
    observer.observe(target);
  })();
</script>

{% stylesheet %}
  /* --- Schema class rule (required by base.css transparent override) --- */
  .story-blood-vessels-section {
    background: transparent;
  }

  /* --- Sticky child — owns the black background --- */
  .story-blood-vessels {
    position: relative;
    background-color: var(--os-color-black, #000);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* --- Heart glow (entry pulse) --- */
  .story-blood-vessels__heart-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 200px;
    height: 200px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(188, 15, 15, 0.8) 0%,
      rgba(188, 15, 15, 0.3) 40%,
      transparent 70%
    );
    z-index: 2;
    animation: sbv-pulse 1s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes sbv-pulse {
    0%, 100% {
      transform: translate(-50%, -50%) scale(0.95);
      opacity: 0.4;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.05);
      opacity: 0.8;
    }
  }

  /* --- Video element --- */
  .story-blood-vessels__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    opacity: 0;
  }

  /* --- Canvas fallback --- */
  .story-blood-vessels__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0;
  }

  /* --- Headline overlay --- */
  .story-blood-vessels__headline {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 801px;
    text-align: center;
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 48px;
    line-height: 52px;
    letter-spacing: -1px;
    color: #ffffff;
    z-index: 3;
    opacity: 0;
    padding-inline: 24px;
  }

  .story-blood-vessels__headline p {
    margin: 0;
  }

  .story-blood-vessels__headline strong {
    font-weight: 700;
  }

  /* --- Exit copy overlay --- */
  .story-blood-vessels__exit-copy {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 1200px;
    width: 100%;
    text-align: center;
    z-index: 3;
    opacity: 0;
    padding-inline: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .story-blood-vessels__exit-copy-serif {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 48px;
    line-height: 52px;
    letter-spacing: -1px;
    color: #ffffff;
  }

  .story-blood-vessels__exit-copy-serif p {
    margin: 0;
  }

  .story-blood-vessels__exit-copy-serif strong {
    font-weight: 700;
  }

  .story-blood-vessels__exit-divider {
    width: 80px;
    height: 1px;
    background: rgba(255, 255, 255, 0.4);
    flex-shrink: 0;
  }

  .story-blood-vessels__exit-copy-bold {
    font-family: var(--font-accent--family);
    font-weight: 700;
    font-size: 20px;
    line-height: 24px;
    color: #ffffff;
  }

  .story-blood-vessels__exit-copy-bold p {
    margin: 0;
  }

  /* --- Scroll hint --- */
  .story-blood-vessels__scroll-hint {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    z-index: 3;
  }

  .story-blood-vessels__scroll-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.32);
  }

  .story-blood-vessels__scroll-chevron {
    color: rgba(255, 255, 255, 0.32);
    font-size: 14px;
    animation: sbv-bob 2s ease-in-out infinite;
  }

  @keyframes sbv-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  /* --- Narrative blocks (optional, hidden by default) --- */
  .story-blood-vessels__narrative {
    position: absolute;
    z-index: 3;
    max-width: 480px;
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: clamp(20px, 2vw, 32px);
    line-height: 1.4;
    color: #ffffff;
    opacity: 0;
    will-change: transform, opacity;
    padding-inline: 24px;
  }

  .story-blood-vessels__narrative p {
    margin: 0;
  }

  /* --- Fallback image (hidden by default, shown in reduced motion) --- */
  .story-blood-vessels__fallback {
    display: none;
  }

  .story-blood-vessels__fallback-img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* --- Mobile --- */
  @media screen and (max-width: 749px) {
    .story-blood-vessels__headline {
      font-size: 32px;
      line-height: 38px;
      max-width: 90%;
    }

    .story-blood-vessels__exit-copy {
      max-width: 90%;
      gap: 16px;
    }

    .story-blood-vessels__exit-copy-serif {
      font-size: 32px;
      line-height: 38px;
    }

    .story-blood-vessels__exit-copy-bold {
      font-size: 16px;
      line-height: 20px;
    }

    .story-blood-vessels__heart-glow {
      width: 140px;
      height: 140px;
    }

    .story-blood-vessels__scroll-hint {
      bottom: 16px;
    }

    .story-blood-vessels__narrative {
      max-width: 85vw;
      padding-inline: 16px;
    }
  }

  /* --- Reduced motion: static fallback layout --- */
  @media (prefers-reduced-motion: reduce) {
    .story-blood-vessels {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 48px;
      padding: 60px 24px;
    }

    .story-blood-vessels__heart-glow {
      display: none;
      animation: none;
    }

    .story-blood-vessels__video,
    .story-blood-vessels__canvas,
    .story-blood-vessels__scroll-hint {
      display: none;
    }

    .story-blood-vessels__headline {
      position: static;
      opacity: 1;
      transform: none;
      order: 1;
    }

    .story-blood-vessels__fallback {
      display: block;
      max-width: 100%;
      order: 2;
    }

    .story-blood-vessels__exit-copy {
      position: static;
      opacity: 1;
      transform: none;
      order: 3;
    }

    .story-blood-vessels__narrative {
      position: static;
      opacity: 1;
      transform: none;
      will-change: auto;
      order: 4;
    }

    .story-blood-vessels__scroll-chevron {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blood Vessels Chapter",
  "class": "story-blood-vessels-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "headline_text",
      "label": "Headline",
      "default": "<p>Nitric Oxide keeps those 60,000 miles open, flowing\u2026 and <strong>alive.</strong></p>"
    },
    {
      "type": "richtext",
      "id": "exit_copy_serif",
      "label": "Exit copy (serif)",
      "default": "<p>We didn\u2019t discover it. But we did have the nerve to <strong>take the Nobel-winning science out of the lab</strong></p>"
    },
    {
      "type": "richtext",
      "id": "exit_copy_bold",
      "label": "Exit copy (bold)",
      "default": "<p>\u2014 and bring it to the people who needed it. That\u2019s where the revolution started.</p>"
    },
    {
      "type": "header",
      "content": "Scroll hint"
    },
    {
      "type": "text",
      "id": "hint_label",
      "label": "Hint label",
      "default": "scroll to reveal"
    },
    {
      "type": "header",
      "content": "Animation asset"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Scroll-scrub video URL",
      "info": "Direct URL to a video file. Encode with frequent keyframes (every 1\u20132 frames) for smooth scrubbing."
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Poster / fallback image"
    },
    {
      "type": "header",
      "content": "Scroll behavior"
    },
    {
      "type": "range",
      "id": "pin_distance",
      "label": "Pin distance",
      "min": 1000,
      "max": 8000,
      "step": 500,
      "default": 5000,
      "unit": "px",
      "info": "Extra scroll height while the scene stays pinned"
    },
    {
      "type": "range",
      "id": "overlap_distance",
      "label": "Overlap distance",
      "min": 1000,
      "max": 15000,
      "step": 500,
      "default": 5000,
      "unit": "px",
      "info": "How far this section slides over the previous chapter. Keep this smaller than the NO molecule chapter total height."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "narrative_copy",
      "name": "Narrative copy",
      "limit": 6,
      "settings": [
        {
          "type": "checkbox",
          "id": "enabled",
          "label": "Show this text",
          "default": false
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
