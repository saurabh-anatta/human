{%- liquid
  assign pin_distance = section.settings.pin_distance | default: 2000
  assign offsets = '40,10,50,20,0,35,15,45,5,30,55,10,40,25,50' | split: ','
-%}

<div
  class="story-chapter"
  data-anchor="the-people"
  style="height: calc(100vh + {{ pin_distance }}px); --os-chapter-z: 1;"
>
  <div
    class="story-chapter__sticky story-everyday-people"
    data-section-id="{{ section.id }}"
  >

    {%- comment -%} Headline {%- endcomment -%}
    <div class="story-everyday-people__content">
      {%- if section.settings.headline_text != blank -%}
        <div class="story-everyday-people__headline">
          {{ section.settings.headline_text }}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Photo grid — 15 staggered columns {%- endcomment -%}
    <div class="story-everyday-people__grid">
      {%- for col in (0..14) -%}
        {%- assign col_offset = offsets[col] -%}

        {%- comment -%} Compute opacity based on column distance from center (7) {%- endcomment -%}
        {%- assign dist = col | minus: 7 -%}
        {%- if dist < 0 -%}
          {%- assign dist = dist | times: -1 -%}
        {%- endif -%}

        {%- if dist >= 7 -%}
          {%- assign tile_opacity = '0.19' -%}
        {%- elsif dist == 6 -%}
          {%- assign tile_opacity = '0.35' -%}
        {%- elsif dist == 5 -%}
          {%- assign tile_opacity = '0.55' -%}
        {%- elsif dist == 4 -%}
          {%- assign tile_opacity = '0.71' -%}
        {%- elsif dist == 3 -%}
          {%- assign tile_opacity = '0.85' -%}
        {%- else -%}
          {%- assign tile_opacity = '1.0' -%}
        {%- endif -%}

        <div class="story-everyday-people__column" style="--sep-col-offset: {{ col_offset }}px;" data-col="{{ col }}">
          {%- assign tile_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'photo_tile' -%}
              {%- assign block_col = tile_index | modulo: 15 -%}
              {%- if block_col == col -%}
                <div class="story-everyday-people__tile" style="--sep-tile-opacity: {{ tile_opacity }};" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 156 }}"
                      alt=""
                      width="78"
                      height="105"
                      loading="lazy"
                    >
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- assign tile_index = tile_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<script type="module">
  (function () {
    var utilsUrl = {{ 'story-utils.js' | asset_url | json }};
    var sectionUrl = {{ 'story-everyday-people.js' | asset_url | json }};
    var sectionEl = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!sectionEl) return;

    var target = sectionEl.closest('.story-chapter') || sectionEl;
    var observer = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) {
          observer.disconnect();
          Promise.all([import(utilsUrl), import(sectionUrl)]).then(function (modules) {
            var utils = modules[0];
            var mod = modules[1];
            mod.init(sectionEl, utils);
          });
          break;
        }
      }
    }, { rootMargin: '400px' });
    observer.observe(target);
  })();
</script>

{% stylesheet %}
  /* --- Schema class rule (required by base.css transparent override) --- */
  .story-everyday-people-section {
    background: transparent;
  }

  /* --- Eliminate gap between previous section and this one --- */
  .story-everyday-people-section .story-chapter {
    margin-top: 0;
  }

  /* --- Sticky child — black chapter background --- */
  .story-everyday-people {
    position: relative;
    background: #000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* --- Content wrapper --- */
  .story-everyday-people__content {
    padding: 0 24px;
    box-sizing: border-box;
    width: 100%;
    max-width: 1100px;
  }

  /* --- Headline --- */
  .story-everyday-people__headline {
    font-family: 'Moderat Serif Regular', serif;
    font-weight: 400;
    font-size: 32px;
    line-height: 40px;
    letter-spacing: -1px;
    color: #fff;
    text-align: left;
    margin-bottom: 43px;
  }

  .story-everyday-people__headline p {
    margin: 0;
  }

  /* --- Photo grid — 15 columns, bleeds past viewport edges --- */
  .story-everyday-people__grid {
    display: flex;
    gap: 24px;
    justify-content: center;
    width: 110vw;
    margin-left: -5vw;
  }

  /* --- Column — vertical stagger via custom property --- */
  .story-everyday-people__column {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex-shrink: 0;
    transform: translateY(calc(var(--sep-col-offset, 0px) + var(--sep-parallax, 0px)));
  }

  /* --- Individual tile --- */
  .story-everyday-people__tile {
    width: 78px;
    height: 105px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    opacity: 0;
    transform: scale(0.94);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .story-everyday-people__tile.is-visible {
    opacity: var(--sep-tile-opacity, 1);
    transform: scale(1);
  }

  .story-everyday-people__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* --- Mobile --- */
  @media screen and (max-width: 749px) {
    .story-everyday-people__content {
      padding: 0 16px;
    }

    .story-everyday-people__headline {
      font-size: 24px;
      line-height: 32px;
      margin-bottom: 24px;
    }

    .story-everyday-people__grid {
      gap: 12px;
    }

    .story-everyday-people__column {
      gap: 10px;
    }

    .story-everyday-people__tile {
      width: 52px;
      height: 70px;
    }

    /* Hide outermost 2 columns on each side */
    .story-everyday-people__column:nth-child(-n+2),
    .story-everyday-people__column:nth-child(n+14) {
      display: none;
    }
  }

  /* --- Reduced motion --- */
  @media (prefers-reduced-motion: reduce) {
    .story-everyday-people__tile {
      opacity: var(--sep-tile-opacity, 1) !important;
      transform: none !important;
      transition: none;
      will-change: auto;
    }

    .story-everyday-people__column {
      will-change: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Everyday People",
  "class": "story-everyday-people-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "headline_text",
      "label": "Headline",
      "default": "<p>And then, everyone else. Over 2.7 million customers. Over 700 million doses delivered.</p>"
    },
    {
      "type": "header",
      "content": "Scroll behavior"
    },
    {
      "type": "range",
      "id": "pin_distance",
      "label": "Pin distance",
      "min": 1000,
      "max": 8000,
      "step": 500,
      "default": 2000,
      "unit": "px",
      "info": "Extra scroll height while the scene stays pinned"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "photo_tile",
      "name": "Photo tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        }
      ]
    }
  ]
}
{% endschema %}
