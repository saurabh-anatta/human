{%- liquid
  assign pin_distance = section.settings.pin_distance | default: 3000
-%}

<div
  class="story-chapter"
  data-anchor="the-athletes"
  style="height: calc(100vh + {{ pin_distance }}px); --os-chapter-z: 1;"
>
  <div
    class="story-chapter__sticky story-athletes-branching-lines"
    data-section-id="{{ section.id }}"
  >

    {%- comment -%} Branching SVG layer — behind content {%- endcomment -%}
    <svg
      class="story-athletes-branching-lines__branches"
      viewBox="0 0 1052 1458"
      preserveAspectRatio="xMidYMin meet"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <defs>
        {%- comment -%} Gradients: red (#BC0F0F) at burst → grey (#666) along strand {%- endcomment -%}
        <linearGradient id="sabl-grad-left-outer" gradientUnits="userSpaceOnUse" x1="526" y1="180" x2="0" y2="1100">
          <stop offset="0%" stop-color="#BC0F0F" />
          <stop offset="40%" stop-color="#888888" />
          <stop offset="100%" stop-color="#666666" stop-opacity="0.3" />
        </linearGradient>
        <linearGradient id="sabl-grad-left-mid" gradientUnits="userSpaceOnUse" x1="526" y1="180" x2="212" y2="1140">
          <stop offset="0%" stop-color="#BC0F0F" />
          <stop offset="40%" stop-color="#888888" />
          <stop offset="100%" stop-color="#666666" stop-opacity="0.3" />
        </linearGradient>
        <linearGradient id="sabl-grad-left-inner" gradientUnits="userSpaceOnUse" x1="526" y1="180" x2="421" y2="1050">
          <stop offset="0%" stop-color="#BC0F0F" />
          <stop offset="40%" stop-color="#888888" />
          <stop offset="100%" stop-color="#666666" stop-opacity="0.3" />
        </linearGradient>
        <linearGradient id="sabl-grad-center" gradientUnits="userSpaceOnUse" x1="526" y1="180" x2="526" y2="1350">
          <stop offset="0%" stop-color="#BC0F0F" />
          <stop offset="35%" stop-color="#888888" />
          <stop offset="100%" stop-color="#666666" stop-opacity="0.3" />
        </linearGradient>
        <linearGradient id="sabl-grad-right-inner" gradientUnits="userSpaceOnUse" x1="526" y1="180" x2="631" y2="1350">
          <stop offset="0%" stop-color="#BC0F0F" />
          <stop offset="40%" stop-color="#888888" />
          <stop offset="100%" stop-color="#666666" stop-opacity="0.3" />
        </linearGradient>
        <linearGradient id="sabl-grad-right-mid" gradientUnits="userSpaceOnUse" x1="526" y1="180" x2="840" y2="1340">
          <stop offset="0%" stop-color="#BC0F0F" />
          <stop offset="40%" stop-color="#888888" />
          <stop offset="100%" stop-color="#666666" stop-opacity="0.3" />
        </linearGradient>
        <linearGradient id="sabl-grad-right-outer" gradientUnits="userSpaceOnUse" x1="526" y1="180" x2="1052" y2="1200">
          <stop offset="0%" stop-color="#BC0F0F" />
          <stop offset="40%" stop-color="#888888" />
          <stop offset="100%" stop-color="#666666" stop-opacity="0.3" />
        </linearGradient>
      </defs>

      {%- comment -%} Centre continuation red line — draws first {%- endcomment -%}
      <line
        data-center-continuation
        x1="526" y1="0" x2="526" y2="180"
        stroke="#BC0F0F"
        stroke-width="1"
        fill="none"
      />

      {%- comment -%} 7 branching strands — fanning symmetrically from burst point (526, 180) {%- endcomment -%}
      {%- comment -%} Left outer — wide sweep to x≈0 {%- endcomment -%}
      <path
        data-strand
        data-strand-index="0"
        class="story-athletes-branching-lines__strand"
        d="M 526 180 C 520 380, 180 520, 0 1100"
        stroke="url(#sabl-grad-left-outer)"
      />

      {%- comment -%} Left middle — moderate sweep to x≈212 {%- endcomment -%}
      <path
        data-strand
        data-strand-index="1"
        class="story-athletes-branching-lines__strand"
        d="M 526 180 C 522 400, 310 560, 212 1140"
        stroke="url(#sabl-grad-left-mid)"
      />

      {%- comment -%} Left inner — gentle sweep to x≈421 {%- endcomment -%}
      <path
        data-strand
        data-strand-index="2"
        class="story-athletes-branching-lines__strand"
        d="M 526 180 C 524 350, 460 480, 421 1050"
        stroke="url(#sabl-grad-left-inner)"
      />

      {%- comment -%} Centre strand — straight down {%- endcomment -%}
      <path
        data-strand
        data-strand-index="3"
        class="story-athletes-branching-lines__strand"
        d="M 526 180 C 526 400, 526 700, 526 1350"
        stroke="url(#sabl-grad-center)"
      />

      {%- comment -%} Right inner — gentle sweep to x≈631 {%- endcomment -%}
      <path
        data-strand
        data-strand-index="4"
        class="story-athletes-branching-lines__strand"
        d="M 526 180 C 528 350, 592 480, 631 1350"
        stroke="url(#sabl-grad-right-inner)"
      />

      {%- comment -%} Right middle — moderate sweep to x≈840 {%- endcomment -%}
      <path
        data-strand
        data-strand-index="5"
        class="story-athletes-branching-lines__strand"
        d="M 526 180 C 530 400, 742 560, 840 1340"
        stroke="url(#sabl-grad-right-mid)"
      />

      {%- comment -%} Right outer — wide sweep to x≈1052 {%- endcomment -%}
      <path
        data-strand
        data-strand-index="6"
        class="story-athletes-branching-lines__strand"
        d="M 526 180 C 532 380, 872 520, 1052 1200"
        stroke="url(#sabl-grad-right-outer)"
      />
    </svg>

    {%- comment -%} Content layer {%- endcomment -%}
    <div class="story-athletes-branching-lines__content">
      {%- if section.settings.headline_text != blank -%}
        <div class="story-athletes-branching-lines__headline story-reveal">
          {{ section.settings.headline_text }}
        </div>
      {%- endif -%}

      <div class="story-athletes-branching-lines__redline" data-redline></div>

      {%- if section.settings.subheadline_text != blank -%}
        <div class="story-athletes-branching-lines__subheadline story-reveal">
          {{ section.settings.subheadline_text }}
        </div>
      {%- endif -%}

      <div class="story-athletes-branching-lines__reel">
        {%- for block in section.blocks -%}
          {%- if block.type == 'reel_tile' -%}
            <div class="story-athletes-branching-lines__tile story-reveal" {{ block.shopify_attributes }}>
              {%- if block.settings.video_url != blank -%}
                {%- assign poster_src = '' -%}
                {%- if block.settings.poster_image != blank -%}
                  {%- assign poster_src = block.settings.poster_image | image_url: width: 320 -%}
                {%- endif -%}
                <video
                  data-reel-video
                  muted
                  loop
                  playsinline
                  preload="none"
                  {% if poster_src != blank %}poster="{{ poster_src }}"{% endif %}
                  aria-hidden="true"
                >
                  <source src="{{ block.settings.video_url }}" type="video/mp4">
                </video>
              {%- elsif block.settings.poster_image != blank -%}
                <img
                  src="{{ block.settings.poster_image | image_url: width: 320 }}"
                  alt=""
                  width="160"
                  height="215"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</div>

<script type="module">
  (function () {
    var utilsUrl = {{ 'story-utils.js' | asset_url | json }};
    var sectionUrl = {{ 'story-athletes-branching-lines.js' | asset_url | json }};
    var sectionEl = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!sectionEl) return;

    var target = sectionEl.closest('.story-chapter') || sectionEl;
    var observer = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) {
          observer.disconnect();
          Promise.all([import(utilsUrl), import(sectionUrl)]).then(function (modules) {
            var utils = modules[0];
            var section = modules[1];
            section.init(sectionEl, utils);
          });
          break;
        }
      }
    }, { rootMargin: '400px' });
    observer.observe(target);
  })();
</script>

{% stylesheet %}
  /* --- Schema class rule (required by base.css transparent override) --- */
  .story-athletes-branching-lines-section {
    background: transparent;
  }

  /* --- Eliminate gap between university-stadium and this section --- */
  .story-athletes-branching-lines-section .story-chapter {
    margin-top: 0;
  }

  /* --- Sticky child — black chapter background --- */
  .story-athletes-branching-lines {
    position: relative;
    background: #000;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* --- Content layer (above SVG) --- */
  .story-athletes-branching-lines__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 950px;
    padding: 80px 24px 40px;
    box-sizing: border-box;
    height: 100%;
  }

  /* --- Headline --- */
  .story-athletes-branching-lines__headline {
    font-family: 'Moderat Serif Regular', serif;
    font-weight: 400;
    font-size: 32px;
    line-height: 52px;
    letter-spacing: -1px;
    color: #fff;
    text-align: center;
    max-width: 820px;
  }

  .story-athletes-branching-lines__headline p {
    margin: 0;
  }

  /* --- Red divider line --- */
  .story-athletes-branching-lines__redline {
    width: 1px;
    height: 100px;
    background: var(--os-color-red, #BC0F0F);
    margin: 38px 0;
    transform: scaleY(0);
    transform-origin: top;
    flex-shrink: 0;
  }

  /* --- Sub-headline --- */
  .story-athletes-branching-lines__subheadline {
    font-family: 'Moderat Serif Regular', serif;
    font-weight: 400;
    font-size: 32px;
    line-height: 40px;
    letter-spacing: -1px;
    color: #fff;
    text-align: center;
    max-width: 950px;
  }

  .story-athletes-branching-lines__subheadline p {
    margin: 0;
  }

  /* --- Branching SVG (behind content) --- */
  .story-athletes-branching-lines__branches {
    position: absolute;
    z-index: 1;
    left: 50%;
    transform: translateX(-50%);
    top: 42%;
    width: 100%;
    max-width: 1052px;
    height: auto;
    pointer-events: none;
  }

  .story-athletes-branching-lines__strand {
    fill: none;
    stroke-width: 1;
  }

  /* --- Reel area --- */
  .story-athletes-branching-lines__reel {
    display: flex;
    gap: 48px;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 2;
    margin-top: auto;
    padding-bottom: 40px;
    flex-shrink: 0;
  }

  /* --- Reel tile --- */
  .story-athletes-branching-lines__tile {
    width: 160px;
    height: 215px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .story-athletes-branching-lines__tile video,
  .story-athletes-branching-lines__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* --- Mobile --- */
  @media screen and (max-width: 749px) {
    .story-athletes-branching-lines__content {
      padding: 48px 16px 24px;
    }

    .story-athletes-branching-lines__headline {
      font-size: 24px;
      line-height: 36px;
    }

    .story-athletes-branching-lines__redline {
      height: 60px;
      margin: 24px 0;
    }

    .story-athletes-branching-lines__subheadline {
      font-size: 24px;
      line-height: 36px;
    }

    .story-athletes-branching-lines__branches {
      max-width: 90vw;
    }

    .story-athletes-branching-lines__reel {
      gap: 16px;
      overflow-x: auto;
      justify-content: flex-start;
      padding: 0 16px 24px;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      width: 100%;
      box-sizing: border-box;
    }

    .story-athletes-branching-lines__tile {
      min-width: 120px;
      width: 120px;
      height: 162px;
      scroll-snap-align: start;
    }
  }

  /* --- Reduced motion --- */
  @media (prefers-reduced-motion: reduce) {
    .story-athletes-branching-lines__redline {
      transform: scaleY(1) !important;
      will-change: auto;
    }

    .story-athletes-branching-lines__strand {
      stroke-dashoffset: 0 !important;
      will-change: auto;
    }

    .story-athletes-branching-lines .story-reveal {
      opacity: 1 !important;
      transform: none !important;
      will-change: auto;
    }

    .story-athletes-branching-lines__branches {
      opacity: 1 !important;
      will-change: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Athletes & Branches",
  "class": "story-athletes-branching-lines-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "headline_text",
      "label": "Headline",
      "default": "<p>Then the athletes showed up. 54 team championships. Seven straight in college football. Four straight in college baseball. Two straight in pro hockey.</p>"
    },
    {
      "type": "richtext",
      "id": "subheadline_text",
      "label": "Sub-headline",
      "default": "<p>Over 2,000 teams. More than 50,000 athletes — all running on the same molecule.</p>"
    },
    {
      "type": "header",
      "content": "Scroll behavior"
    },
    {
      "type": "range",
      "id": "pin_distance",
      "label": "Pin distance",
      "min": 1000,
      "max": 8000,
      "step": 500,
      "default": 3000,
      "unit": "px",
      "info": "Extra scroll height while the scene stays pinned"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "reel_tile",
      "name": "Reel tile",
      "settings": [
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL",
          "info": "Direct link to an MP4 video file. Leave blank to show the poster image only."
        },
        {
          "type": "image_picker",
          "id": "poster_image",
          "label": "Poster image"
        }
      ]
    }
  ]
}
{% endschema %}
