{%- liquid
  assign pin_distance = section.settings.pin_distance | default: 5000
  assign overlap_distance = section.settings.overlap_distance | default: 2000
-%}

{%- capture inline_styles -%}
  --os-chapter-z: 50; margin-top: -{{ overlap_distance }}px;
{%- endcapture -%}

<div
  class="story-chapter story-chapter--overlay"
  data-anchor="why-we-made-it"
  style="height: calc(100vh + {{ pin_distance }}px); {{ inline_styles }}"
>
  <div
    class="story-chapter__sticky story-timeline"
    data-section-id="{{ section.id }}"
  >

    <div class="story-timeline__track" aria-hidden="true">
      <div class="story-timeline__line"></div>
    </div>

    <div class="story-timeline__milestones">
      {%- for block in section.blocks -%}
        {%- if block.type == 'milestone' -%}
          <div class="story-timeline__milestone" {{ block.shopify_attributes }}>
            <div class="story-timeline__meta">
              <div class="story-timeline__year">{{ block.settings.year_label }}</div>
              <div class="story-timeline__label">{{ block.settings.subtitle }}</div>
            </div>

            <div class="story-timeline__dot"></div>

            <div class="story-timeline__card">
              <div class="story-timeline__video-wrap">
                {%- if block.settings.poster_image != blank -%}
                  <div class="story-timeline__poster">
                    {{
                      block.settings.poster_image
                      | image_url: width: 864
                      | image_tag:
                        widths: '375,432,864',
                        sizes: '(min-width: 750px) 432px, calc(100vw - 64px)',
                        alt: block.settings.year_label,
                        loading: 'lazy',
                        class: 'story-timeline__poster-img'
                    }}
                  </div>
                {%- endif -%}

                {%- if block.settings.video_url != blank -%}
                  <video
                    class="story-timeline__video"
                    playsinline
                    muted
                    loop
                    preload="none"
                    {%- if block.settings.poster_image != blank %}
                      poster="{{ block.settings.poster_image | image_url: width: 864 }}"
                    {%- endif %}
                    src="{{ block.settings.video_url }}"
                    aria-hidden="true"
                  ></video>
                {%- endif -%}
              </div>

              {%- if block.settings.caption_text != blank -%}
                <div class="story-timeline__caption">
                  {{ block.settings.caption_text }}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

<script type="module">
  (function () {
    var utilsUrl = {{ 'story-utils.js' | asset_url | json }};
    var sectionUrl = {{ 'story-timeline.js' | asset_url | json }};
    var sectionEl = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!sectionEl) return;

    var target = sectionEl.closest('.story-chapter') || sectionEl;
    var observer = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) {
          observer.disconnect();
          Promise.all([import(utilsUrl), import(sectionUrl)]).then(function (modules) {
            var utils = modules[0];
            var section = modules[1];
            section.init(sectionEl, utils);
          });
          break;
        }
      }
    }, { rootMargin: '400px' });
    observer.observe(target);
  })();
</script>

{% stylesheet %}
  /* --- Schema class rule (required by base.css transparent override) --- */
  .story-timeline-section {
    background: transparent;
  }

  /* --- Sticky child — owns the black background --- */
  .story-timeline {
    position: relative;
    background-color: var(--os-color-black, #000);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* --- Vertical line track (spans full height of the sticky child) --- */
  .story-timeline__track {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    z-index: 1;
  }

  .story-timeline__line {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100%;
    background: #767676;
    clip-path: inset(0 0 100% 0);
  }

  /* --- Milestones container --- */
  .story-timeline__milestones {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 100px;
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
    padding: 120px 24px 100px;
  }

  /* --- Individual milestone (3-column grid: meta | dot | card) --- */
  .story-timeline__milestone {
    display: grid;
    grid-template-columns: 1fr 10px 1fr;
    column-gap: 24px;
    align-items: start;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .story-timeline__milestone.is-visible {
    opacity: 1;
    transform: none;
  }

  /* --- Meta column (year + label, right-aligned) --- */
  .story-timeline__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    padding-top: 4px;
  }

  .story-timeline__year {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 48px;
    line-height: 52px;
    color: #ffffff;
  }

  .story-timeline__label {
    font-family: var(--font-labels--family, '(K) Uniforma', sans-serif);
    font-weight: 400;
    font-size: 14px;
    line-height: 16px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: var(--os-color-light-text, #F5F5F5);
  }

  /* --- Dot (center column) --- */
  .story-timeline__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ffffff;
    align-self: start;
    margin-top: 21px;
    transform: scale(0);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .story-timeline__dot.is-visible {
    transform: scale(1);
  }

  /* --- Card column (video + caption) --- */
  .story-timeline__card {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .story-timeline__video-wrap {
    position: relative;
    width: 100%;
    max-width: 432px;
    aspect-ratio: 432 / 243;
    border-radius: 8px;
    overflow: hidden;
    background: #151421;
  }

  .story-timeline__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-timeline__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .story-timeline__poster-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .story-timeline__caption {
    max-width: 432px;
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    color: #ffffff;
  }

  .story-timeline__caption p {
    margin: 0;
  }

  .story-timeline__caption strong {
    font-weight: 700;
  }

  /* --- Mobile --- */
  @media screen and (max-width: 749px) {
    .story-timeline__milestones {
      gap: 64px;
      padding: 80px 16px 64px;
      max-width: 100%;
    }

    .story-timeline__milestone {
      grid-template-columns: 10px 1fr;
      column-gap: 16px;
    }

    .story-timeline__dot {
      grid-column: 1;
      grid-row: 1 / 3;
      margin-top: 14px;
    }

    .story-timeline__meta {
      grid-column: 2;
      grid-row: 1;
      align-items: flex-start;
    }

    .story-timeline__card {
      grid-column: 2;
      grid-row: 2;
    }

    .story-timeline__year {
      font-size: 32px;
      line-height: 38px;
    }

    .story-timeline__video-wrap {
      max-width: 100%;
    }

    .story-timeline__caption {
      max-width: 100%;
    }

    .story-timeline__track {
      left: 24px;
      transform: none;
    }
  }

  /* --- Reduced motion --- */
  @media (prefers-reduced-motion: reduce) {
    .story-timeline__line {
      clip-path: none;
    }

    .story-timeline__milestone {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .story-timeline__dot {
      transform: scale(1);
      transition: none;
    }

    .story-timeline__video {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Timeline Chapter",
  "class": "story-timeline-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Scroll behavior"
    },
    {
      "type": "range",
      "id": "pin_distance",
      "label": "Pin distance",
      "min": 1000,
      "max": 8000,
      "step": 500,
      "default": 5000,
      "unit": "px",
      "info": "Extra scroll height while the scene stays pinned"
    },
    {
      "type": "range",
      "id": "overlap_distance",
      "label": "Overlap distance",
      "min": 1000,
      "max": 9500,
      "step": 500,
      "default": 2000,
      "unit": "px",
      "info": "How far this section slides over the previous chapter"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "year_label",
          "label": "Year",
          "default": "1998"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "nitric oxide discovery"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL",
          "info": "Direct link to a video file. Videos autoplay muted and loop while visible."
        },
        {
          "type": "image_picker",
          "id": "poster_image",
          "label": "Poster image"
        },
        {
          "type": "richtext",
          "id": "caption_text",
          "label": "Caption"
        }
      ]
    }
  ]
}
{% endschema %}
