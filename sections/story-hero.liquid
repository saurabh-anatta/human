<div
  class="story-chapter"
  data-anchor="hero"
  style="height: calc(100vh + {{ section.settings.pin_distance }}px)"
>
  <div
    class="story-hero"
    style="--sh-padding-top: {{ section.settings.padding-block-start }}px; --sh-padding-bottom: {{ section.settings.padding-block-end }}px"
  >
    <canvas class="story-hero__canvas" aria-hidden="true"></canvas>

    <div class="story-hero__ticks" aria-hidden="true">
      <span></span>
      <span></span>
    </div>

    <div class="story-hero__content">
      {%- if section.settings.logo_image != blank -%}
        {%- assign logo_alt = section.settings.logo_image.alt | default: shop.name -%}
        <img
          class="story-hero__logo"
          src="{{ section.settings.logo_image | image_url: width: 870 }}"
          srcset="{{ section.settings.logo_image | image_url: width: 435 }} 435w, {{ section.settings.logo_image | image_url: width: 870 }} 870w"
          sizes="clamp(200px, 30vw, 435px)"
          alt="{{ logo_alt | escape }}"
          width="435"
          height="75"
          loading="eager"
        >
      {%- endif -%}

      <div class="story-hero__tagline">
        {{ section.settings.tagline }}
      </div>
    </div>

    <div class="story-hero__discover-group">
      <span class="story-hero__discover-label">{{ section.settings.discover_label }}</span>
      <div class="story-hero__chevrons">
        {{ 'chevron-down.svg' | inline_asset_content }}
        {{ 'chevron-down-2.svg' | inline_asset_content }}
        {{ 'chevron-down-3.svg' | inline_asset_content }}
      </div>
    </div>
  </div>
</div>

{{ 'story-scroll.css' | asset_url | stylesheet_tag }}

<script type="module">
  (function () {
    var utilsUrl = {{ 'story-utils.js' | asset_url | json }};
    var heroUrl = {{ 'story-hero.js' | asset_url | json }};
    var sectionEl = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionEl) return;

    var chapter = sectionEl.querySelector('.story-chapter');
    if (!chapter) return;

    var observer = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) {
          observer.disconnect();
          Promise.all([import(utilsUrl), import(heroUrl)]).then(function (modules) {
            var utils = modules[0];
            var mod = modules[1];
            mod.init(sectionEl, utils);
          });
          break;
        }
      }
    }, { rootMargin: '400px' });

    observer.observe(chapter);
  })();
</script>

{% stylesheet %}
/* ------------------------------------------------------------------ */
/*  story-hero-section — CRITICAL: background: transparent             */
/*  base.css forces .shopify-section:not(.header-section) :is(.section)*/
/*  to transparent. We comply and put the real bg on .story-hero.      */
/* ------------------------------------------------------------------ */
.story-hero-section {
  background: transparent;
}

/* ------------------------------------------------------------------ */
/*  Chapter wrapper — height set inline, position from story-scroll.css*/
/* ------------------------------------------------------------------ */

/* ------------------------------------------------------------------ */
/*  Sticky inner viewport                                              */
/* ------------------------------------------------------------------ */
.story-hero {
  position: sticky;
  top: 0;
  height: 100vh;
  z-index: 10;
  background: var(--os-color-red, #BC0F0F);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: var(--sh-padding-top, 0px);
  padding-bottom: var(--sh-padding-bottom, 0px);
}

/* ------------------------------------------------------------------ */
/*  Canvas                                                             */
/* ------------------------------------------------------------------ */
.story-hero__canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  mix-blend-mode: multiply;
  opacity: 0.15;
  pointer-events: none;
}

/* ------------------------------------------------------------------ */
/*  Decorative ticks                                                   */
/* ------------------------------------------------------------------ */
.story-hero__ticks {
  position: absolute;
  top: 40px;
  right: 60px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.story-hero__ticks span {
  display: block;
  width: 1px;
  height: 16px;
  background: rgba(255, 255, 255, 0.4);
}

/* ------------------------------------------------------------------ */
/*  Content area                                                       */
/* ------------------------------------------------------------------ */
.story-hero__content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 8px;
}

.story-hero__logo {
  width: clamp(200px, 30vw, 435px);
  height: auto;
}

.story-hero__tagline {
  font-family: 'Moderat Serif', serif;
  font-weight: 400;
  font-size: 20px;
  line-height: 52px;
  letter-spacing: -0.5px;
  color: var(--os-color-light-text, #F5F5F5);
  text-align: center;
  max-width: 1200px;
  padding: 0 24px;
}

.story-hero__tagline strong {
  font-weight: 700;
}

/* ------------------------------------------------------------------ */
/*  Discover group                                                     */
/* ------------------------------------------------------------------ */
.story-hero__discover-group {
  position: absolute;
  bottom: 60px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  z-index: 1;
}

.story-hero__discover-label {
  font-family: '(K) Uniforma', sans-serif;
  font-weight: 400;
  font-size: 14px;
  line-height: 16px;
  letter-spacing: 0.75px;
  text-transform: uppercase;
  color: #FFFFFF;
}

.story-hero__chevrons {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.story-hero__chevrons svg {
  display: block;
  width: 24px;
  height: 24px;
}

/* Chevron bob animation */
@keyframes chevron-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(4px); }
}

.story-hero__chevrons svg {
  animation: chevron-bob 2s ease-in-out infinite;
}

.story-hero__chevrons svg:nth-child(2) {
  animation-delay: 0.18s;
}

.story-hero__chevrons svg:nth-child(3) {
  animation-delay: 0.36s;
}

/* ------------------------------------------------------------------ */
/*  Mobile                                                             */
/* ------------------------------------------------------------------ */
@media screen and (max-width: 749px) {
  .story-hero__logo {
    width: clamp(180px, 60vw, 300px);
  }

  .story-hero__tagline {
    font-size: 16px;
    line-height: 28px;
  }

  .story-hero__discover-group {
    bottom: 40px;
  }

  .story-hero__ticks {
    top: 24px;
    right: 24px;
  }
}

/* ------------------------------------------------------------------ */
/*  Reduced motion                                                     */
/* ------------------------------------------------------------------ */
@media (prefers-reduced-motion: reduce) {
  .story-hero__chevrons svg {
    animation: none;
  }

  .story-hero__discover-group {
    opacity: 1 !important;
    transform: translateX(-50%) !important;
  }

  .story-hero__canvas {
    will-change: auto;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "class": "story-hero-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image"
    },
    {
      "type": "richtext",
      "id": "tagline",
      "label": "Tagline",
      "default": "<p>Cardiovascular health is <strong>everything health</strong></p>"
    },
    {
      "type": "text",
      "id": "discover_label",
      "label": "Discover label",
      "default": "DISCOVER"
    },
    {
      "type": "header",
      "content": "Scroll behavior"
    },
    {
      "type": "range",
      "id": "pin_distance",
      "label": "Pin distance",
      "min": 1000,
      "max": 9500,
      "step": 500,
      "default": 2000,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ]
}
{% endschema %}
