

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  {{ section.shopify_attributes }}
>
  {% assign direction_class = 'utilities--direction-' | append: section.settings.content_direction %}
  {% assign direction_mobile_class = 'utilities--direction-mobile-' | append: section.settings.content_direction_mobile %}
  <div
    class="utilities utilities--blocks-{{ section.blocks.size }} {{ direction_class }} {{ direction_mobile_class }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %} --border-width: {{ section.settings.divider_thickness }}px; --gap: {{ section.settings.gap }}px; --gap-mobile: {{ section.settings.gap_mobile }}px;"
    data-testid="footer-utilities"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .utilities {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-mobile, var(--gap));
    text-wrap: nowrap;
    color: var(--color-foreground-muted);

    @media screen and (max-width: 749px) {
      --padding-block-start: var(--padding-block-start-mobile);
      --padding-block-end: var(--padding-block-end-mobile);
    }
  }

  .utilities--direction-mobile-row {
    flex-direction: row;
    justify-content: space-between;
    flex-wrap: wrap;
    align-items: center;
  }

  .utilities > * {
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    /* Column direction on desktop */
    .utilities--direction-column {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--gap);

      > * {
        text-align: left;
      }
    }

    /* Row direction on desktop: grid-based layout */
    .utilities--direction-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      justify-content: center;
      gap: var(--gap);
      align-items: center;
      text-align: left;

      > * {
        text-align: left;
        justify-self: start;
      }
    }

    /* 1 block */
    .utilities--direction-row.utilities--blocks-1 {
      grid-template-columns: 1fr;
      justify-content: start;

      > * {
        justify-self: start;
      }
    }

    /* 2 blocks */
    .utilities--direction-row.utilities--blocks-2 {
      grid-template-columns: 1fr 1fr;

      > *:nth-child(2) {
        justify-self: end;
        text-align: right;
      }
    }

    /* 3 blocks */
    .utilities--direction-row.utilities--blocks-3 {
      grid-template-columns: 1fr auto 1fr;

      > *:nth-child(2) {
        justify-self: center;
        text-align: center;
      }

      > *:nth-child(3) {
        justify-self: end;
        text-align: right;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policies_and_links",
  "tag": "div",
  "class": "footer-utilities",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "Desktop Alignment",
      "options": [
        {
          "value": "row",
          "label": "t:options.horizontal"
        },
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "content_direction_mobile",
      "label": "Mobile Alignment",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.desktop_padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:content.mobile_padding"
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "footer-copyright"
    },
    {
      "type": "footer-policy-menu"
    },
    {
      "type": "footer-disclaimer"
    },
    {
      "type": "custom-text"
    },
    {
      "type": "footer-widget-button"
    },
    {
      "type": "group"
    },
    {
      "type": "visibility"
    }
  ],
  "presets": [
    {
      "name": "t:names.policies_and_links",
      "category": "t:categories.footer",
      "settings": {
        "content_direction":"column",
        "content_direction_mobile": "row"
      },
      "blocks": {
        "disclaimer": {
        "type": "footer-disclaimer"
        },
        "copyright": {
          "type": "footer-copyright"
        }
      },
      "block_order": ["disclaimer","copyright"]
    }
  ]
}
{% endschema %}
