<style>
  #shopify-section-{{ section.id }} {
    z-index: 1;
  }
</style>

{%- liquid
  capture inline_styles
    echo '--stp-scroll-height: ' | append: section.settings.scroll_multiplier | append: '00vh;'
  endcapture
-%}

<div class="story-the-problem" style="{{ inline_styles }}">

  {%- comment -%} === Intro (normal flow, not pinned) === {%- endcomment -%}
  <div class="story-the-problem__intro">
    {%- if section.settings.eyebrow_text != blank -%}
      <span class="story-the-problem__eyebrow" data-reveal>
        {{- section.settings.eyebrow_text -}}
      </span>
    {%- endif -%}

    {%- if section.settings.heading_text != blank -%}
      <h2 class="story-the-problem__heading" data-reveal>
        {{- section.settings.heading_text -}}
      </h2>
    {%- endif -%}
  </div>

  {%- comment -%} === Scroll-pinned chart area === {%- endcomment -%}
  <div class="story-the-problem__scroll-container">
    <div class="story-the-problem__stage">

      {%- comment -%} Background images {%- endcomment -%}
      {%- if section.settings.bg_image_1 != blank -%}
        <img
          class="story-the-problem__bg-image"
          data-bg-index="0"
          src="{{ section.settings.bg_image_1 | image_url: width: 1920 }}"
          alt=""
          width="1920"
          height="1080"
          loading="lazy"
        >
      {%- endif -%}
      {%- if section.settings.bg_image_2 != blank -%}
        <img
          class="story-the-problem__bg-image"
          data-bg-index="1"
          src="{{ section.settings.bg_image_2 | image_url: width: 1920 }}"
          alt=""
          width="1920"
          height="1080"
          loading="lazy"
        >
      {%- endif -%}
      {%- if section.settings.bg_image_3 != blank -%}
        <img
          class="story-the-problem__bg-image"
          data-bg-index="2"
          src="{{ section.settings.bg_image_3 | image_url: width: 1920 }}"
          alt=""
          width="1920"
          height="1080"
          loading="lazy"
        >
      {%- endif -%}

      {%- comment -%} Desaturation overlay {%- endcomment -%}
      <div class="story-the-problem__desat-overlay"></div>

      {%- comment -%} Dark overlay (JS-controlled) {%- endcomment -%}
      <div class="story-the-problem__dark-overlay"></div>

      {%- comment -%} Chart container {%- endcomment -%}
      <div class="story-the-problem__chart-container">
        <svg class="story-the-problem__chart" viewBox="0 0 900 600" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Nitric Oxide decline chart" role="img">

          {%- comment -%} Grid lines {%- endcomment -%}
          <g class="story-the-problem__chart-grid">
            {%- comment -%} Horizontal grid lines (100%, 75%, 25%, 0%) {%- endcomment -%}
            <line x1="120" y1="40" x2="860" y2="40" stroke="rgba(255,255,255,0.15)" stroke-width="0.5"/>
            <line x1="120" y1="165" x2="860" y2="165" stroke="rgba(255,255,255,0.15)" stroke-width="0.5"/>
            <line x1="120" y1="415" x2="860" y2="415" stroke="rgba(255,255,255,0.15)" stroke-width="0.5"/>
            <line x1="120" y1="540" x2="860" y2="540" stroke="rgba(255,255,255,0.15)" stroke-width="0.5"/>
            {%- comment -%} Dashed 50% reference line {%- endcomment -%}
            <line x1="120" y1="290" x2="860" y2="290" stroke="rgba(255,255,255,0.3)" stroke-width="0.5" stroke-dasharray="8 4"/>
            {%- comment -%} Vertical grid lines (Age 20–60) {%- endcomment -%}
            <line x1="120" y1="40" x2="120" y2="540" stroke="rgba(255,255,255,0.15)" stroke-width="0.5"/>
            <line x1="305" y1="40" x2="305" y2="540" stroke="rgba(255,255,255,0.15)" stroke-width="0.5"/>
            <line x1="490" y1="40" x2="490" y2="540" stroke="rgba(255,255,255,0.15)" stroke-width="0.5"/>
            <line x1="675" y1="40" x2="675" y2="540" stroke="rgba(255,255,255,0.15)" stroke-width="0.5"/>
            <line x1="860" y1="40" x2="860" y2="540" stroke="rgba(255,255,255,0.15)" stroke-width="0.5"/>
          </g>

          {%- comment -%} Axis labels {%- endcomment -%}
          <g class="story-the-problem__chart-axes">
            {%- comment -%} Rotated Y-axis title {%- endcomment -%}
            <text transform="translate(25,290) rotate(-90)" text-anchor="middle" class="story-the-problem__axis-title">{{ section.settings.y_axis_label }}</text>
            {%- comment -%} Y-axis tick labels {%- endcomment -%}
            <text x="110" y="45" text-anchor="end">100%</text>
            <text x="110" y="170" text-anchor="end">75%</text>
            <text x="110" y="295" text-anchor="end">50%</text>
            <text x="110" y="420" text-anchor="end">25%</text>
            <text x="110" y="545" text-anchor="end">0%</text>
            {%- comment -%} X-axis tick labels {%- endcomment -%}
            <text x="60" y="575" text-anchor="end" class="story-the-problem__axis-title">AGE</text>
            <text x="120" y="575" text-anchor="middle">20</text>
            <text x="305" y="575" text-anchor="middle">30</text>
            <text x="490" y="575" text-anchor="middle">40</text>
            <text x="675" y="575" text-anchor="middle">50</text>
            <text x="860" y="575" text-anchor="middle">60</text>
          </g>

          {%- comment -%} Legend {%- endcomment -%}
          <g class="story-the-problem__chart-legend" transform="translate(700,55)">
            <line x1="0" y1="0" x2="30" y2="0" stroke="#FFFFFF" stroke-width="2"/>
            <text x="38" y="4">{{ section.settings.legend_label_1 }}</text>
            <line x1="0" y1="20" x2="30" y2="20" stroke="#FFFFFF" stroke-width="2.5" stroke-opacity="0.7"/>
            <text x="38" y="24">{{ section.settings.legend_label_2 }}</text>
          </g>

          {%- comment -%} Decline curves {%- endcomment -%}
          <path class="story-the-problem__curve" data-curve="women"
            d="M 120 50 C 180 50 245 110 305 165 C 365 220 430 260 490 290 C 550 320 615 365 675 390 C 735 415 800 435 860 440"
            stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
          <path class="story-the-problem__curve" data-curve="men"
            d="M 120 70 C 180 70 245 140 305 200 C 365 260 430 295 490 325 C 550 355 615 395 675 420 C 735 445 800 465 860 470"
            stroke="#FFFFFF" stroke-width="2.5" stroke-opacity="0.7" stroke-linecap="round"/>

        </svg>

        {%- comment -%} Callout blocks {%- endcomment -%}
        {%- for block in section.blocks -%}
          <div
            class="story-the-problem__callout"
            data-callout-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.text }}
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Stat overlay {%- endcomment -%}
      <div class="story-the-problem__stat-overlay">
        <div class="story-the-problem__gradient"></div>
        <div class="story-the-problem__stat">
          {%- if section.settings.stat_number != blank -%}
            <span class="story-the-problem__stat-number">
              {{- section.settings.stat_number -}}
            </span>
          {%- endif -%}
          {%- if section.settings.stat_text != blank -%}
            <p class="story-the-problem__stat-text">
              {{- section.settings.stat_text -}}
            </p>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</div>

<script type="module">
  const [{ createScrollProgress, createRevealObserver, prefersReducedMotion }, { initTheProblem }] = await Promise.all([
    import({{ 'story-scroll-utils.js' | asset_url | json }}),
    import({{ 'story-the-problem.js' | asset_url | json }})
  ]);
  const section = document.getElementById('shopify-section-{{ section.id }}');
  if (section) initTheProblem(section, { createScrollProgress, createRevealObserver, prefersReducedMotion });
</script>

{% stylesheet %}
  /* ===== Root ===== */
  .story-the-problem {
    background: #000000;
    position: relative;
  }

  /* ===== Intro (normal flow, not pinned) ===== */
  .story-the-problem__intro {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 40px 20px;
    background: #000000;
  }

  /* ===== Eyebrow ===== */
  .story-the-problem__eyebrow {
    font-family: var(--font-labels--family), sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 16px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: #A0A0A0;
    text-align: center;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  .story-the-problem__eyebrow.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== Heading ===== */
  .story-the-problem__heading {
    font-family: var(--font-heading--family), sans-serif;
    font-weight: 400;
    font-size: 60px;
    line-height: 52px;
    letter-spacing: -1px;
    color: #F5F5F5;
    text-align: center;
    max-width: 1085px;
    margin: 0;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s ease 0.15s, transform 0.8s ease 0.15s;
  }

  .story-the-problem__heading.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== Scroll container (tall wrapper for pinning) ===== */
  .story-the-problem__scroll-container {
    height: var(--stp-scroll-height, 800vh);
  }

  /* ===== Sticky stage (viewport-locked) ===== */
  .story-the-problem__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: #000000;
  }

  /* ===== Background images ===== */
  .story-the-problem__bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    opacity: 0;
  }

  /* ===== Desaturation overlay (mix-blend-mode: color) ===== */
  .story-the-problem__desat-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #D9D9D9;
    mix-blend-mode: color;
    pointer-events: none;
  }

  /* ===== Dark overlay (JS controls bg-color + blur) ===== */
  .story-the-problem__dark-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  @supports not (backdrop-filter: blur(1px)) {
    .story-the-problem__dark-overlay {
      background: rgba(0, 0, 0, 0.6);
    }
  }

  /* ===== Chart container ===== */
  .story-the-problem__chart-container {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 60px;
  }

  /* ===== SVG chart ===== */
  .story-the-problem__chart {
    width: 100%;
    max-width: 900px;
    height: auto;
    opacity: 0;
  }

  .story-the-problem__chart text {
    font-family: var(--font-labels--family), sans-serif;
    font-size: 12px;
    font-weight: 600;
    fill: #A0A0A0;
  }

  .story-the-problem__axis-title {
    font-size: 10px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
  }

  /* ===== Decline curves ===== */
  .story-the-problem__curve {
    fill: none;
  }

  /* ===== Callout blocks ===== */
  .story-the-problem__callout {
    position: absolute;
    background: rgba(0, 0, 0, 0.7);
    color: #F5F5F5;
    font-family: var(--font-labels--family), sans-serif;
    font-size: 14px;
    line-height: 20px;
    padding: 12px 16px;
    border-radius: 4px;
    max-width: 260px;
    opacity: 0;
    pointer-events: none;
    z-index: 5;
  }

  .story-the-problem__callout p {
    margin: 0;
  }

  .story-the-problem__callout strong {
    font-weight: 700;
    color: #FFFFFF;
  }

  /* Callout positioning by index */
  .story-the-problem__callout[data-callout-index="0"] {
    top: 20%;
    left: 18%;
  }

  .story-the-problem__callout[data-callout-index="1"] {
    top: 40%;
    left: 15%;
  }

  .story-the-problem__callout[data-callout-index="2"] {
    bottom: 28%;
    right: 12%;
  }

  /* ===== Stat overlay ===== */
  .story-the-problem__stat-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 6;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 60px;
    opacity: 0;
    pointer-events: none;
  }

  /* ===== Bottom gradient ===== */
  .story-the-problem__gradient {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 306px;
    background: linear-gradient(0deg, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) 100%);
    pointer-events: none;
  }

  /* ===== Stat group ===== */
  .story-the-problem__stat {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 13px;
  }

  .story-the-problem__stat-number {
    font-family: 'Stabil Grotesk', var(--font-heading--family), sans-serif;
    font-weight: 700;
    font-size: 96px;
    line-height: 60px;
    color: #FFFFFF;
    text-align: center;
  }

  .story-the-problem__stat-text {
    font-family: var(--font-heading--family), sans-serif;
    font-weight: 400;
    font-size: 32px;
    line-height: 40px;
    letter-spacing: -1px;
    color: #F5F5F5;
    text-align: center;
    max-width: 984px;
    margin: 0;
  }

  /* ===== Reduced motion: static layout ===== */
  @media (prefers-reduced-motion: reduce) {
    .story-the-problem__scroll-container {
      height: auto;
    }

    .story-the-problem__stage {
      position: relative;
    }

    .story-the-problem__eyebrow,
    .story-the-problem__heading {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .story-the-problem__chart {
      opacity: 1;
    }

    .story-the-problem__bg-image[data-bg-index="2"] {
      opacity: 1;
    }

    .story-the-problem__desat-overlay {
      display: none;
    }

    .story-the-problem__dark-overlay {
      background: rgba(0, 0, 0, 0.5) !important;
    }

    .story-the-problem__curve {
      stroke-dashoffset: 0 !important;
      stroke-dasharray: none !important;
    }

    .story-the-problem__callout {
      opacity: 1;
    }

    .story-the-problem__stat-overlay {
      opacity: 1;
    }
  }

  /* ===== Mobile overrides ===== */
  @media screen and (max-width: 749px) {
    .story-the-problem__intro {
      padding-inline: 16px;
    }

    .story-the-problem__heading {
      font-size: 36px;
      line-height: 40px;
    }

    .story-the-problem__chart-container {
      padding: 24px 16px;
    }

    .story-the-problem__callout {
      font-size: 12px;
      line-height: 16px;
      max-width: 200px;
      padding: 8px 12px;
    }

    .story-the-problem__callout[data-callout-index="0"] {
      top: 15%;
      left: 8%;
    }

    .story-the-problem__callout[data-callout-index="1"] {
      top: 38%;
      left: 5%;
    }

    .story-the-problem__callout[data-callout-index="2"] {
      bottom: 25%;
      right: 5%;
    }

    .story-the-problem__stat-number {
      font-size: 64px;
      line-height: 48px;
    }

    .story-the-problem__stat-text {
      font-size: 24px;
      line-height: 32px;
    }

    .story-the-problem__stat-overlay {
      padding-bottom: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story The Problem",
  "limit": 1,
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow",
      "default": "THE PROBLEM"
    },
    {
      "type": "textarea",
      "id": "heading_text",
      "label": "Heading",
      "default": "Nitric Oxide production declines with age, beginning in your 20s."
    },
    {
      "type": "header",
      "content": "Background images"
    },
    {
      "type": "image_picker",
      "id": "bg_image_1",
      "label": "Background image 1"
    },
    {
      "type": "image_picker",
      "id": "bg_image_2",
      "label": "Background image 2"
    },
    {
      "type": "image_picker",
      "id": "bg_image_3",
      "label": "Background image 3"
    },
    {
      "type": "header",
      "content": "Chart"
    },
    {
      "type": "text",
      "id": "y_axis_label",
      "label": "Y-axis label",
      "default": "NITRIC OXIDE PRODUCTION"
    },
    {
      "type": "text",
      "id": "legend_label_1",
      "label": "Legend label 1",
      "default": "Women"
    },
    {
      "type": "text",
      "id": "legend_label_2",
      "label": "Legend label 2",
      "default": "Men"
    },
    {
      "type": "header",
      "content": "Final stat"
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "Stat number",
      "default": "50%"
    },
    {
      "type": "textarea",
      "id": "stat_text",
      "label": "Stat description",
      "default": "of nitric oxide by the average 40-year-old"
    },
    {
      "type": "header",
      "content": "Scroll behavior"
    },
    {
      "type": "range",
      "id": "scroll_multiplier",
      "label": "Scroll distance multiplier",
      "min": 6,
      "max": 15,
      "step": 1,
      "default": 8,
      "unit": "x"
    }
  ],
  "blocks": [
    {
      "type": "callout",
      "name": "Chart callout",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Callout text"
        }
      ]
    }
  ]
}
{% endschema %}
