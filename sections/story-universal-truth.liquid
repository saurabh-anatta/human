      {%- comment -%} Decorative arrow elements {%- endcomment -%}
      <img
        class="story-universal-truth__arrow"
        src="{{ 'arrow-8.svg' | asset_url }}"
        alt=""
        width="57"
        height="57"
        loading="lazy"
        style="top: 22%; left: 18%; width: 57px; height: 57px; transform: rotate(0.8deg);"
        aria-hidden="true"
      >
      <img
        class="story-universal-truth__arrow"
        src="{{ 'arrow-10.svg' | asset_url }}"
        alt=""
        width="78"
        height="57"
        loading="lazy"
        style="top: 20%; right: 18%; width: 78px; height: 57px; transform: rotate(2.5deg);"
        aria-hidden="true"
      >
      <img
        class="story-universal-truth__arrow"
        src="{{ 'arrow-9.svg' | asset_url }}"
        alt=""
        width="67"
        height="67"
        loading="lazy"
        style="top: 58%; left: 22%; width: 67px; height: 67px; transform: rotate(-0.8deg);"
        aria-hidden="true"
      >
      <img
        class="story-universal-truth__arrow"
        src="{{ 'arrow-11.svg' | asset_url }}"
        alt=""
        width="92"
        height="67"
        loading="lazy"
        style="top: 55%; right: 20%; width: 92px; height: 67px; transform: rotate(-2.5deg);"
        aria-hidden="true"
      >

      {%- comment -%} Text content layer {%- endcomment -%}
      <div class="story-universal-truth__content">
        {%- if eyebrow_text != blank -%}
          <span class="story-universal-truth__eyebrow">{{ eyebrow_text }}</span>
        {%- endif -%}

        <div class="story-universal-truth__text-block-1">
          {%- if text_block_1 != blank -%}
            <h2 class="story-universal-truth__heading">{{ text_block_1 }}</h2>
          {%- endif -%}
          {%- if supporting_line_1 != blank -%}
            <p class="story-universal-truth__supporting story-universal-truth__supporting-words">{{ supporting_line_1 }}</p>
          {%- endif -%}
        </div>

        <div class="story-universal-truth__text-block-2">
          {%- if text_block_2_eyebrow != blank -%}
            <span class="story-universal-truth__eyebrow-inline">{{ text_block_2_eyebrow }}</span>
          {%- endif -%}
          {%- if text_block_2 != blank -%}
            <div class="story-universal-truth__body">{{ text_block_2 }}</div>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</div>

<script type="module">
  (function () {
    const utilsUrl = {{ 'story-scroll-utils.js' | asset_url | json }};
    const sectionUrl = {{ 'story-universal-truth.js' | asset_url | json }};

    Promise.all([import(utilsUrl), import(sectionUrl)]).then(function ([utils, section]) {
      const sectionEl = document.querySelector('[data-section-id="{{ section.id }}"]');
      if (!sectionEl) return;
      section.init(sectionEl, utils);
    });
  })();
</script>

{% stylesheet %}
  /* ------------------------------------------------------------------ *\
     Universal Truth — .story-universal-truth
     Prefix: --sut-
  \* ------------------------------------------------------------------ */

  /* Background on the .shopify-section wrapper (avoids base.css .section trap) */
  .story-universal-truth-section {
    background-color: #F5F5F5;
    position: relative;
    z-index: 1;
  }

  .story-universal-truth {
    position: relative;
  }

  /* Scroll track: tall container that drives the sticky pinning */
  .story-universal-truth__scroll-track {
    height: calc(var(--sut-scroll-distance, 5) * 100vh);
  }

  /* Sticky viewport: pins while the scroll track scrolls past */
  .story-universal-truth__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Background decorative vessel network */
  .story-universal-truth__bg-vessels {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
  }

  /* SVG vessel overlay */
  .story-universal-truth__vessel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  /* Decorative arrow images */
  .story-universal-truth__arrow {
    position: absolute;
    opacity: 0;
    z-index: 2;
    pointer-events: none;
    max-width: none;
  }

  /* Text content layer */
  .story-universal-truth__content {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-rows: auto auto;
    justify-items: center;
    align-content: center;
    text-align: center;
    max-width: 800px;
    width: 100%;
    padding-inline: 24px;
    gap: 20px;
  }

  /* Eyebrow (grid row 1) */
  .story-universal-truth__eyebrow {
    grid-row: 1;
    grid-column: 1;
    font-family: "Uniforma Semibold", sans-serif;
    font-weight: 600;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: #000000;
    opacity: 0;
  }

  /* Text blocks stack in the same grid cell (row 2) */
  .story-universal-truth__text-block-1,
  .story-universal-truth__text-block-2 {
    grid-row: 2;
    grid-column: 1;
    will-change: transform, opacity;
  }

  /* Text block 1 */
  .story-universal-truth__text-block-1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .story-universal-truth__heading {
    font-family: "Stabil Grotesk Bold", sans-serif;
    font-weight: 700;
    font-size: 32px;
    line-height: 40px;
    letter-spacing: 0;
    color: #767676;
    margin: 0;
    opacity: 0;
    transform: scale(3.5);
    will-change: transform, opacity;
  }

  .story-universal-truth__heading em {
    font-style: normal;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .story-universal-truth__supporting {
    font-family: var(--font-heading--family), serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 30px;
    letter-spacing: -0.5px;
    color: #767676;
    margin: 0;
  }

  .story-universal-truth__word {
    display: inline;
    opacity: 0;
    will-change: opacity;
  }

  /* Text block 2 */
  .story-universal-truth__text-block-2 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    opacity: 0;
    transform: scale(1.3);
  }

  .story-universal-truth__eyebrow-inline {
    font-family: "Uniforma Semibold", sans-serif;
    font-weight: 600;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: #000000;
  }

  .story-universal-truth__body {
    font-family: var(--font-heading--family), serif;
    font-weight: 400;
    font-size: 24px;
    line-height: 36px;
    letter-spacing: -0.5px;
    color: #767676;
  }

  .story-universal-truth__body p {
    margin: 0;
  }

  .story-universal-truth__body strong {
    color: #000000;
    font-weight: 700;
  }

  /* ------ Mobile ------ */

  @media screen and (max-width: 749px) {
    .story-universal-truth__scroll-track {
      height: calc(var(--sut-scroll-distance, 5) * 60vh);
    }

    .story-universal-truth__content {
      max-width: 90vw;
      padding-inline: 16px;
    }

    .story-universal-truth__heading {
      font-size: 24px;
      line-height: 32px;
    }

    .story-universal-truth__supporting {
      font-size: 16px;
      line-height: 24px;
    }

    .story-universal-truth__body {
      font-size: 18px;
      line-height: 28px;
    }

    .story-universal-truth__arrow {
      display: none;
    }
  }

  /* ------ Reduced motion ------ */

  @media (prefers-reduced-motion: reduce) {
    .story-universal-truth__scroll-track {
      height: auto;
    }

    .story-universal-truth__sticky {
      position: relative;
      height: auto;
      min-height: 100vh;
      min-height: 100svh;
    }

    .story-universal-truth__eyebrow,
    .story-universal-truth__heading,
    .story-universal-truth__supporting,
    .story-universal-truth__text-block-1,
    .story-universal-truth__text-block-2,
    .story-universal-truth__arrow,
    .story-universal-truth__word,
    .story-universal-truth__bg-vessels {
      opacity: 1 !important;
      transform: none !important;
    }

    .story-universal-truth__vessel-path {
      stroke-dashoffset: 0 !important;
    }

    .story-universal-truth__bg-vessels path {
      stroke-dashoffset: 0 !important;
    }

    .story-universal-truth__heading,
    .story-universal-truth__supporting,
    .story-universal-truth__text-block-1,
    .story-universal-truth__text-block-2,
    .story-universal-truth__word {
      will-change: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Universal truth",
  "class": "story-universal-truth-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "THE UNIVERSAL TRUTH"
    },
    {
      "type": "header",
      "content": "Text block 1"
    },
    {
      "type": "inline_richtext",
      "id": "text_block_1",
      "label": "Heading",
      "default": "America has been looking at cardiovascular health <em>all wrong.</em>"
    },
    {
      "type": "textarea",
      "id": "supporting_line_1",
      "label": "Supporting line",
      "default": "Some say it's about your heart problems. Or something you deal with in old age."
    },
    {
      "type": "header",
      "content": "Text block 2"
    },
    {
      "type": "text",
      "id": "text_block_2_eyebrow",
      "label": "Eyebrow",
      "default": "BUT THE REAL STORY ISN'T ABOUT THE HEART \u2014"
    },
    {
      "type": "richtext",
      "id": "text_block_2",
      "label": "Body",
      "default": "<p>It's about the <strong>60,000 miles of blood vessels</strong> doing the heavy lifting behind it. every second, <strong>for every one of us.</strong></p>"
    },
    {
      "type": "header",
      "content": "Vessel"
    },
    {
      "type": "color",
      "id": "vessel_color",
      "label": "Vessel color",
      "default": "#BC0F0F"
    },
    {
      "type": "header",
      "content": "Scroll distance"
    },
    {
      "type": "range",
      "id": "scroll_distance",
      "label": "Scroll distance",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5,
      "unit": "\u00d7vh"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ]
}
{% endschema %}
