        <path class="story-universal-truth__vessel-path" data-phase="cage-1" d="M 720,700 C 747,717 781,732 787,756 C 780,778 745,792 720,810" fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
