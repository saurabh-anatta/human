{%- liquid
  assign eyebrow_text = section.settings.eyebrow_text
  assign text_block_1 = section.settings.text_block_1
  assign supporting_line_1 = section.settings.supporting_line_1
  assign text_block_2_eyebrow = section.settings.text_block_2_eyebrow
  assign text_block_2 = section.settings.text_block_2
  assign vessel_color = section.settings.vessel_color
  assign scroll_distance = section.settings.scroll_distance
-%}

{%- capture inline_styles -%}
  --sut-scroll-distance: {{ scroll_distance }};
  --sut-vessel-color: {{ vessel_color }};
  padding-block-start: {{ section.settings['padding-block-start'] }}px;
  padding-block-end: {{ section.settings['padding-block-end'] }}px;
{%- endcapture -%}

<div
  class="story-universal-truth"
  data-section-id="{{ section.id }}"
  data-anchor="universal-truth"
  style="{{ inline_styles }}"
>
  <div class="story-universal-truth__scroll-track">
    <div class="story-universal-truth__sticky">

      {%- comment -%} Inline SVG vessel with stroke-animated paths {%- endcomment -%}
      <svg
        class="story-universal-truth__vessel"
        viewBox="0 0 1440 1000"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        {%- comment -%} Stem top: central line flowing downward {%- endcomment -%}
        <path
          class="story-universal-truth__vessel-path"
          data-phase="stem-top"
          d="M 720 0 Q 718 160 720 320"
          fill="none"
          stroke="var(--sut-vessel-color)"
          stroke-width="2"
          stroke-linecap="round"
        />

        {%- comment -%} Branch paths curving outward {%- endcomment -%}
        <path
          class="story-universal-truth__vessel-path"
          data-phase="branch-1"
          d="M 720 290 C 750 340 850 410 940 480"
          fill="none"
          stroke="var(--sut-vessel-color)"
          stroke-width="2"
          stroke-linecap="round"
        />
        <path
          class="story-universal-truth__vessel-path"
          data-phase="branch-2"
          d="M 720 290 C 690 340 590 410 500 480"
          fill="none"
          stroke="var(--sut-vessel-color)"
          stroke-width="2"
          stroke-linecap="round"
        />
        <path
          class="story-universal-truth__vessel-path"
          data-phase="branch-3"
          d="M 720 310 C 770 360 940 430 1100 510"
          fill="none"
          stroke="var(--sut-vessel-color)"
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <path
          class="story-universal-truth__vessel-path"
          data-phase="branch-4"
          d="M 720 310 C 670 360 500 430 340 510"
          fill="none"
          stroke="var(--sut-vessel-color)"
          stroke-width="1.5"
          stroke-linecap="round"
        />

        {%- comment -%} Converge paths curving back inward {%- endcomment -%}
        <path
          class="story-universal-truth__vessel-path"
          data-phase="converge-1"
          d="M 940 480 C 900 550 790 630 720 700"
          fill="none"
          stroke="var(--sut-vessel-color)"
          stroke-width="2"
          stroke-linecap="round"
        />
        <path
          class="story-universal-truth__vessel-path"
          data-phase="converge-2"
          d="M 500 480 C 540 550 650 630 720 700"
          fill="none"
          stroke="var(--sut-vessel-color)"
          stroke-width="2"
          stroke-linecap="round"
        />
        <path
          class="story-universal-truth__vessel-path"
          data-phase="converge-3"
          d="M 1100 510 C 1040 580 830 660 720 720"
          fill="none"
          stroke="var(--sut-vessel-color)"
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <path
          class="story-universal-truth__vessel-path"
          data-phase="converge-4"
          d="M 340 510 C 400 580 610 660 720 720"
          fill="none"
          stroke="var(--sut-vessel-color)"
          stroke-width="1.5"
          stroke-linecap="round"
        />

        {%- comment -%} Stem bottom: continues downward from convergence {%- endcomment -%}
        <path
          class="story-universal-truth__vessel-path"
          data-phase="stem-bottom"
          d="M 720 700 Q 722 850 720 1000"
          fill="none"
          stroke="var(--sut-vessel-color)"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>

      {%- comment -%} Decorative arrow elements {%- endcomment -%}
      <img
        class="story-universal-truth__arrow"
        src="{{ 'arrow-8.svg' | asset_url }}"
        alt=""
        width="57"
        height="57"
        loading="lazy"
        style="top: 22%; left: 18%; width: 57px; height: 57px; transform: rotate(0.8deg);"
        aria-hidden="true"
      >
      <img
        class="story-universal-truth__arrow"
        src="{{ 'arrow-10.svg' | asset_url }}"
        alt=""
        width="78"
        height="57"
        loading="lazy"
        style="top: 20%; right: 18%; width: 78px; height: 57px; transform: rotate(2.5deg);"
        aria-hidden="true"
      >
      <img
        class="story-universal-truth__arrow"
        src="{{ 'arrow-9.svg' | asset_url }}"
        alt=""
        width="67"
        height="67"
        loading="lazy"
        style="top: 58%; left: 22%; width: 67px; height: 67px; transform: rotate(-0.8deg);"
        aria-hidden="true"
      >
      <img
        class="story-universal-truth__arrow"
        src="{{ 'arrow-11.svg' | asset_url }}"
        alt=""
        width="92"
        height="67"
        loading="lazy"
        style="top: 55%; right: 20%; width: 92px; height: 67px; transform: rotate(-2.5deg);"
        aria-hidden="true"
      >

      {%- comment -%} Text content layer {%- endcomment -%}
      <div class="story-universal-truth__content">
        {%- if eyebrow_text != blank -%}
          <span class="story-universal-truth__eyebrow">{{ eyebrow_text }}</span>
        {%- endif -%}

        <div class="story-universal-truth__text-block-1">
          {%- if text_block_1 != blank -%}
            <h2 class="story-universal-truth__heading">{{ text_block_1 }}</h2>
          {%- endif -%}
          {%- if supporting_line_1 != blank -%}
            <p class="story-universal-truth__supporting">{{ supporting_line_1 }}</p>
          {%- endif -%}
        </div>

        <div class="story-universal-truth__text-block-2">
          {%- if text_block_2_eyebrow != blank -%}
            <span class="story-universal-truth__eyebrow-inline">{{ text_block_2_eyebrow }}</span>
          {%- endif -%}
          {%- if text_block_2 != blank -%}
            <div class="story-universal-truth__body">{{ text_block_2 }}</div>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</div>

<script type="module">
  (function () {
    const utilsUrl = {{ 'story-scroll-utils.js' | asset_url | json }};
    const sectionUrl = {{ 'story-universal-truth.js' | asset_url | json }};

    Promise.all([import(utilsUrl), import(sectionUrl)]).then(function ([utils, section]) {
      const sectionEl = document.querySelector('[data-section-id="{{ section.id }}"]');
      if (!sectionEl) return;
      section.init(sectionEl, utils);
    });
  })();
</script>

{% stylesheet %}
  /* ------------------------------------------------------------------ *\
     Universal Truth — .story-universal-truth
     Prefix: --sut-
  \* ------------------------------------------------------------------ */

  /* Background on the .shopify-section wrapper (avoids base.css .section trap) */
  .story-universal-truth-section {
    background-color: #F5F5F5;
    position: relative;
    z-index: 1;
  }

  .story-universal-truth {
    position: relative;
  }

  /* Scroll track: tall container that drives the sticky pinning */
  .story-universal-truth__scroll-track {
    height: calc(var(--sut-scroll-distance, 5) * 100vh);
  }

  /* Sticky viewport: pins while the scroll track scrolls past */
  .story-universal-truth__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* SVG vessel overlay */
  .story-universal-truth__vessel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* Decorative arrow images */
  .story-universal-truth__arrow {
    position: absolute;
    opacity: 0;
    z-index: 1;
    pointer-events: none;
    max-width: none;
  }

  /* Text content layer */
  .story-universal-truth__content {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: auto auto;
    justify-items: center;
    align-content: center;
    text-align: center;
    max-width: 800px;
    width: 100%;
    padding-inline: 24px;
    gap: 20px;
  }

  /* Eyebrow (grid row 1) */
  .story-universal-truth__eyebrow {
    grid-row: 1;
    grid-column: 1;
    font-family: "Uniforma Semibold", sans-serif;
    font-weight: 600;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: #000000;
    opacity: 0;
  }

  /* Text blocks stack in the same grid cell (row 2) */
  .story-universal-truth__text-block-1,
  .story-universal-truth__text-block-2 {
    grid-row: 2;
    grid-column: 1;
    will-change: transform, opacity;
  }

  /* Text block 1 */
  .story-universal-truth__text-block-1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .story-universal-truth__heading {
    font-family: var(--font-heading--family), serif;
    font-weight: 400;
    font-size: 32px;
    line-height: 52px;
    letter-spacing: -1px;
    color: #767676;
    margin: 0;
    opacity: 0;
    transform: scale(3.5);
    will-change: transform, opacity;
  }

  .story-universal-truth__supporting {
    font-family: var(--font-heading--family), serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 30px;
    letter-spacing: -0.5px;
    color: #767676;
    margin: 0;
    opacity: 0;
    transform: translateY(20px);
    will-change: transform, opacity;
  }

  /* Text block 2 */
  .story-universal-truth__text-block-2 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    opacity: 0;
    transform: scale(1.3);
  }

  .story-universal-truth__eyebrow-inline {
    font-family: "Uniforma Semibold", sans-serif;
    font-weight: 600;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: #000000;
  }

  .story-universal-truth__body {
    font-family: var(--font-heading--family), serif;
    font-weight: 400;
    font-size: 24px;
    line-height: 36px;
    letter-spacing: -0.5px;
    color: #767676;
  }

  .story-universal-truth__body p {
    margin: 0;
  }

  .story-universal-truth__body strong {
    color: #000000;
    font-weight: 700;
  }

  /* ------ Mobile ------ */

  @media screen and (max-width: 749px) {
    .story-universal-truth__scroll-track {
      height: calc(var(--sut-scroll-distance, 5) * 60vh);
    }

    .story-universal-truth__content {
      max-width: 90vw;
      padding-inline: 16px;
    }

    .story-universal-truth__heading {
      font-size: 24px;
      line-height: 36px;
    }

    .story-universal-truth__supporting {
      font-size: 16px;
      line-height: 24px;
    }

    .story-universal-truth__body {
      font-size: 18px;
      line-height: 28px;
    }

    .story-universal-truth__arrow {
      display: none;
    }
  }

  /* ------ Reduced motion ------ */

  @media (prefers-reduced-motion: reduce) {
    .story-universal-truth__scroll-track {
      height: auto;
    }

    .story-universal-truth__sticky {
      position: relative;
      height: auto;
      min-height: 100vh;
      min-height: 100svh;
    }

    .story-universal-truth__eyebrow,
    .story-universal-truth__heading,
    .story-universal-truth__supporting,
    .story-universal-truth__text-block-1,
    .story-universal-truth__text-block-2,
    .story-universal-truth__arrow {
      opacity: 1 !important;
      transform: none !important;
    }

    .story-universal-truth__vessel-path {
      stroke-dashoffset: 0 !important;
    }

    .story-universal-truth__heading,
    .story-universal-truth__supporting,
    .story-universal-truth__text-block-1,
    .story-universal-truth__text-block-2 {
      will-change: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Universal truth",
  "class": "story-universal-truth-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "THE UNIVERSAL TRUTH"
    },
    {
      "type": "header",
      "content": "Text block 1"
    },
    {
      "type": "textarea",
      "id": "text_block_1",
      "label": "Heading",
      "default": "America has been looking at cardiovascular health all wrong."
    },
    {
      "type": "textarea",
      "id": "supporting_line_1",
      "label": "Supporting line",
      "default": "Some say it's about your heart problems. Or something you deal with in old age."
    },
    {
      "type": "header",
      "content": "Text block 2"
    },
    {
      "type": "text",
      "id": "text_block_2_eyebrow",
      "label": "Eyebrow",
      "default": "BUT THE REAL STORY ISN'T ABOUT THE HEART \u2014"
    },
    {
      "type": "richtext",
      "id": "text_block_2",
      "label": "Body",
      "default": "<p>It's about the <strong>60,000 miles of blood vessels</strong> doing the heavy lifting behind it. every second, <strong>for every one of us.</strong></p>"
    },
    {
      "type": "header",
      "content": "Vessel"
    },
    {
      "type": "color",
      "id": "vessel_color",
      "label": "Vessel color",
      "default": "#BC0F0F"
    },
    {
      "type": "header",
      "content": "Scroll distance"
    },
    {
      "type": "range",
      "id": "scroll_distance",
      "label": "Scroll distance",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5,
      "unit": "\u00d7vh"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ]
}
{% endschema %}
