        <path class="story-universal-truth__vessel-path" data-phase="cage-2" d="M 720,810 C 784,823 860,837 875,863 C 858,890 782,905 720,920" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1.5" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-2" d="M 720,810 C 801,821 902,835 920,862 C 900,891 800,906 720,920" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1.5" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-2" d="M 720,810 C 820,820 942,834 965,861 C 940,892 818,907 720,920" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-2" d="M 720,810 C 842,818 988,832 1022,862 C 988,893 842,908 720,920" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1" stroke-linecap="round"/>

        {%- comment -%} Cage 2 — left side strands (mirror, inner to outer) {%- endcomment -%}
        <path class="story-universal-truth__vessel-path" data-phase="cage-2" d="M 720,810 C 706,829 691,844 688,866 C 691,887 708,902 720,920" fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-2" d="M 720,810 C 692,827 657,842 651,864 C 659,887 694,902 720,920" fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-2" d="M 720,810 C 675,825 620,839 611,865 C 621,889 676,904 720,920" fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
