{%- liquid
  assign eyebrow_text = section.settings.eyebrow_text
  assign text_block_1 = section.settings.text_block_1
  assign supporting_line_1 = section.settings.supporting_line_1
  assign text_block_2_eyebrow = section.settings.text_block_2_eyebrow
  assign text_block_2 = section.settings.text_block_2
  assign vessel_color = section.settings.vessel_color
-%}

{%- capture inline_styles -%}
  --sut-vessel-color: {{ vessel_color }};
  padding-block-start: {{ section.settings['padding-block-start'] }}px;
  padding-block-end: {{ section.settings['padding-block-end'] }}px;
{%- endcapture -%}

<div
  class="story-universal-truth"
  data-section-id="{{ section.id }}"
  data-anchor="universal-truth"
  style="{{ inline_styles }}"
>
  {%- comment -%} Screen 1: nav gap → small heartbeat → big heartbeat → text → line {%- endcomment -%}
  <div class="story-universal-truth__screen story-universal-truth__screen--intro">
    <div class="story-universal-truth__line" style="height: 160px;" data-sut-draw="line"></div>

    <svg
      class="story-universal-truth__beat story-universal-truth__beat--small"
      width="120" height="50" viewBox="0 0 120 50" fill="none" aria-hidden="true"
      data-sut-draw="svg"
    >
      <path pathLength="1" d="M 60,0 C 60,8 69,12 50,18 C 39,22 74,27 61,33 C 58,37 60,42 60,50" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
    </svg>

    <svg
      class="story-universal-truth__beat story-universal-truth__beat--big"
      width="240" height="110" viewBox="0 0 240 110" fill="none" aria-hidden="true"
      data-sut-draw="svg"
    >
      <path pathLength="1" d="M 120,0 C 123,12 128,20 100,26 C 52,35 200,33 218,42 C 238,52 44,56 26,66 C 10,75 96,82 114,90 C 121,97 120,103 120,110" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
    </svg>

    <div class="story-universal-truth__line" style="height: 48px;" data-sut-draw="line"></div>

    <div class="story-universal-truth__content story-universal-truth__text-block-1" data-sut-draw="text">
      {%- if eyebrow_text != blank -%}
        <span class="story-universal-truth__eyebrow">{{ eyebrow_text }}</span>
      {%- endif -%}
      {%- if text_block_1 != blank -%}
        <h2 class="story-universal-truth__heading">{{ text_block_1 }}</h2>
      {%- endif -%}
      {%- if supporting_line_1 != blank -%}
        <p class="story-universal-truth__supporting">{{ supporting_line_1 }}</p>
      {%- endif -%}
    </div>

    <div class="story-universal-truth__line-fill">
      <div class="story-universal-truth__line" style="height: 100%;" data-sut-draw="line"></div>
    </div>
  </div>

  {%- comment -%} Screen 2: long line → tree flare (slant + round) → 7 vertical strands {%- endcomment -%}
  <div class="story-universal-truth__screen story-universal-truth__screen--tree">
    <div class="story-universal-truth__line" style="height: 250px;" data-sut-draw="line"></div>

    <svg
      class="story-universal-truth__flare"
      width="340" height="150" viewBox="0 0 340 150" fill="none" aria-hidden="true"
      data-sut-draw="svg"
    >
      <path pathLength="1" d="M 170,0 L 170,150" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
      <path pathLength="1" d="M 170,0 C 188,28 222,44 222,86 L 222,150" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
      <path pathLength="1" d="M 170,0 C 152,28 118,44 118,86 L 118,150" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
      <path pathLength="1" d="M 170,0 C 205,34 274,54 274,98 L 274,150" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
      <path pathLength="1" d="M 170,0 C 135,34 66,54 66,98 L 66,150" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
      <path pathLength="1" d="M 170,0 C 222,40 326,64 326,110 L 326,150" stroke="var(--sut-vessel-color)" stroke-width="1.5" stroke-linecap="round"/>
      <path pathLength="1" d="M 170,0 C 118,40 14,64 14,110 L 14,150" stroke="var(--sut-vessel-color)" stroke-width="1.5" stroke-linecap="round"/>
    </svg>

    <div class="story-universal-truth__strands" data-sut-draw="strands">
      <span class="story-universal-truth__strand" style="--sut-strand-x: 0px;"></span>
      <span class="story-universal-truth__strand" style="--sut-strand-x: 52px;"></span>
      <span class="story-universal-truth__strand" style="--sut-strand-x: -52px;"></span>
      <span class="story-universal-truth__strand" style="--sut-strand-x: 104px;"></span>
      <span class="story-universal-truth__strand" style="--sut-strand-x: -104px;"></span>
      <span class="story-universal-truth__strand story-universal-truth__strand--thin" style="--sut-strand-x: 156px;"></span>
      <span class="story-universal-truth__strand story-universal-truth__strand--thin" style="--sut-strand-x: -156px;"></span>
    </div>
  </div>

  {%- comment -%} Screen 3: text → strands resume → merge into one → long line out {%- endcomment -%}
  <div class="story-universal-truth__screen story-universal-truth__screen--outro">
    <div class="story-universal-truth__content story-universal-truth__text-block-2" data-sut-draw="text">
      {%- if text_block_2_eyebrow != blank -%}
        <span class="story-universal-truth__eyebrow-inline">{{ text_block_2_eyebrow }}</span>
      {%- endif -%}
      {%- if text_block_2 != blank -%}
        <div class="story-universal-truth__body">{{ text_block_2 }}</div>
      {%- endif -%}
    </div>

    <div class="story-universal-truth__strands" data-sut-draw="strands">
      <span class="story-universal-truth__strand" style="--sut-strand-x: 0px;"></span>
      <span class="story-universal-truth__strand" style="--sut-strand-x: 52px;"></span>
      <span class="story-universal-truth__strand" style="--sut-strand-x: -52px;"></span>
      <span class="story-universal-truth__strand" style="--sut-strand-x: 104px;"></span>
      <span class="story-universal-truth__strand" style="--sut-strand-x: -104px;"></span>
      <span class="story-universal-truth__strand story-universal-truth__strand--thin" style="--sut-strand-x: 156px;"></span>
      <span class="story-universal-truth__strand story-universal-truth__strand--thin" style="--sut-strand-x: -156px;"></span>
    </div>

    <svg
      class="story-universal-truth__converge"
      width="340" height="150" viewBox="0 0 340 150" fill="none" aria-hidden="true"
      data-sut-draw="svg"
    >
      <path pathLength="1" d="M 170,0 L 170,150" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
      <path pathLength="1" d="M 222,0 L 222,64 C 222,106 188,122 170,150" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
      <path pathLength="1" d="M 118,0 L 118,64 C 118,106 152,122 170,150" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
      <path pathLength="1" d="M 274,0 L 274,52 C 274,96 205,116 170,150" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
      <path pathLength="1" d="M 66,0 L 66,52 C 66,96 135,116 170,150" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
      <path pathLength="1" d="M 326,0 L 326,40 C 326,86 222,110 170,150" stroke="var(--sut-vessel-color)" stroke-width="1.5" stroke-linecap="round"/>
      <path pathLength="1" d="M 14,0 L 14,40 C 14,86 118,110 170,150" stroke="var(--sut-vessel-color)" stroke-width="1.5" stroke-linecap="round"/>
    </svg>

    <div class="story-universal-truth__line" style="height: 250px;" data-sut-draw="line"></div>
  </div>
</div>

<script type="module">
  (function () {
    const utilsUrl = {{ 'story-scroll-utils.js' | asset_url | json }};
    const sectionUrl = {{ 'story-universal-truth.js' | asset_url | json }};

    Promise.all([import(utilsUrl), import(sectionUrl)]).then(function ([utils, section]) {
      const sectionEl = document.querySelector('[data-section-id="{{ section.id }}"]');
      if (!sectionEl) return;
      section.init(sectionEl, utils);
    });
  })();
</script>

{% stylesheet %}
  /* ------------------------------------------------------------------ *\
     Universal Truth — .story-universal-truth
     Prefix: --sut-
     Natural-flow vessel canvas: three stacked screens the user scrolls
     through. Line segments, heartbeats, tree flare/converge and strands
     draw in one-shot when they enter the viewport (.is-visible).
  \* ------------------------------------------------------------------ */

  /* Background on the .shopify-section wrapper (avoids base.css .section trap) */
  .story-universal-truth-section {
    background-color: #6B6B6D;
    background-image: radial-gradient(130% 110% at 50% 30%, #87878A 0%, #707072 45%, #4E4E50 100%);
    position: relative;
    z-index: 1;
  }

  .story-universal-truth {
    position: relative;
  }

  .story-universal-truth__screen {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .story-universal-truth__screen--outro .story-universal-truth__text-block-2 {
    padding-block: 48px 40px;
  }

  /* ---- Vessel line segments (scroll-scrubbed via JS: scaleY tracks the
     draw-line at ~88% of the viewport, so the tree builds on scroll down
     and un-builds on scroll up) ---- */

  .story-universal-truth__line {
    width: 2px;
    flex-shrink: 0;
    background-color: var(--sut-vessel-color);
    transform: scaleY(0);
    transform-origin: top;
    will-change: transform;
  }

  /* Grow segment that fills the rest of a screen */
  .story-universal-truth__line-fill {
    flex-grow: 1;
    min-height: 80px;
    display: flex;
    justify-content: center;
    width: 2px;
  }

  /* ---- Heartbeats, flare & converge: SVG stroke draw via pathLength=1 ---- */

  .story-universal-truth__beat,
  .story-universal-truth__flare,
  .story-universal-truth__converge {
    flex-shrink: 0;
    display: block;
  }

  .story-universal-truth__beat path,
  .story-universal-truth__flare path,
  .story-universal-truth__converge path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    will-change: stroke-dashoffset;
  }

  /* ---- Vertical strand runs (7 lines, fixed offsets from centre) ---- */

  .story-universal-truth__strands {
    position: relative;
    flex-grow: 1;
    min-height: 300px;
    width: 340px;
    flex-shrink: 0;
  }

  .story-universal-truth__strand {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(50% + var(--sut-strand-x, 0px) - 1px);
    width: 2px;
    background-color: var(--sut-vessel-color);
    transform: scaleY(0);
    transform-origin: top;
    will-change: transform;
  }

  .story-universal-truth__strand--thin {
    width: 1.5px;
  }

  /* ---- Text content ---- */

  .story-universal-truth__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
    max-width: 800px;
    width: 100%;
    padding-inline: 24px;
    opacity: 0;
    transform: translateY(24px);
    will-change: opacity, transform;
  }

  .story-universal-truth__text-block-1 {
    padding-block: 40px;
  }

  .story-universal-truth__eyebrow,
  .story-universal-truth__eyebrow-inline {
    font-family: "Uniforma Semibold", sans-serif;
    font-weight: 600;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: #FFFFFF;
  }

  .story-universal-truth__heading {
    font-family: "Stabil Grotesk Bold", sans-serif;
    font-weight: 700;
    font-size: 32px;
    line-height: 40px;
    letter-spacing: 0;
    color: #FFFFFF;
    margin: 0;
  }

  .story-universal-truth__heading em {
    font-style: normal;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .story-universal-truth__supporting {
    font-family: var(--font-heading--family), serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 30px;
    letter-spacing: -0.5px;
    color: #E4E4E2;
    margin: 0;
  }

  .story-universal-truth__body {
    font-family: var(--font-heading--family), serif;
    font-weight: 400;
    font-size: 24px;
    line-height: 36px;
    letter-spacing: -0.5px;
    color: rgba(255, 255, 255, 0.72);
  }

  .story-universal-truth__body p {
    margin: 0;
  }

  .story-universal-truth__body strong {
    color: #FFFFFF;
    font-weight: 700;
  }

  /* ------ Mobile ------ */

  @media screen and (max-width: 749px) {
    .story-universal-truth__content {
      max-width: 90vw;
      padding-inline: 16px;
    }

    .story-universal-truth__heading {
      font-size: 24px;
      line-height: 32px;
    }

    .story-universal-truth__supporting {
      font-size: 16px;
      line-height: 24px;
    }

    .story-universal-truth__body {
      font-size: 18px;
      line-height: 28px;
    }
  }

  /* ------ Reduced motion ------ */

  @media (prefers-reduced-motion: reduce) {
    .story-universal-truth__line,
    .story-universal-truth__line-fill .story-universal-truth__line,
    .story-universal-truth__strand,
    .story-universal-truth__content {
      transition: none;
      transform: none;
      opacity: 1;
    }

    .story-universal-truth__beat path,
    .story-universal-truth__flare path,
    .story-universal-truth__converge path {
      transition: none;
      stroke-dashoffset: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Universal truth",
  "class": "story-universal-truth-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "THE UNIVERSAL TRUTH"
    },
    {
      "type": "header",
      "content": "Text block 1"
    },
    {
      "type": "inline_richtext",
      "id": "text_block_1",
      "label": "Heading",
      "default": "America has been looking at cardiovascular health <em>all wrong.</em>"
    },
    {
      "type": "textarea",
      "id": "supporting_line_1",
      "label": "Supporting line",
      "default": "Some say it's about your heart problems. Or something you deal with in old age."
    },
    {
      "type": "header",
      "content": "Text block 2"
    },
    {
      "type": "text",
      "id": "text_block_2_eyebrow",
      "label": "Eyebrow",
      "default": "BUT THE REAL STORY ISN'T ABOUT THE HEART —"
    },
    {
      "type": "richtext",
      "id": "text_block_2",
      "label": "Body",
      "default": "<p>It's about the <strong>60,000 miles of blood vessels</strong> doing the heavy lifting behind it. every second, <strong>for every one of us.</strong></p>"
    },
    {
      "type": "header",
      "content": "Vessel"
    },
    {
      "type": "color",
      "id": "vessel_color",
      "label": "Vessel color",
      "default": "#BC0F0F"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ]
}
{% endschema %}
