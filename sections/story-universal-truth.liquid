        <path class="story-universal-truth__vessel-path" data-phase="cage-1" d="M 720,700 C 693,718 659,733 653,754 C 660,776 695,791 720,810" fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-1" d="M 720,700 C 676,717 623,731 613,755 C 622,779 677,794 720,810" fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-1" d="M 720,700 C 657,715 582,730 567,754 C 584,779 659,795 720,810" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1.5" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-1" d="M 720,700 C 640,713 541,728 522,755 C 542,781 641,797 720,810" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1.5" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-1" d="M 720,700 C 621,712 501,727 477,753 C 501,782 623,798 720,810" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1" stroke-linecap="round"/>
