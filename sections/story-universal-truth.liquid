{%- liquid
  assign eyebrow_text = section.settings.eyebrow_text
  assign text_block_1 = section.settings.text_block_1
  assign supporting_line_1 = section.settings.supporting_line_1
  assign text_block_2_eyebrow = section.settings.text_block_2_eyebrow
  assign text_block_2 = section.settings.text_block_2
  assign vessel_color = section.settings.vessel_color
  assign scroll_distance = section.settings.scroll_distance
-%}

{%- capture inline_styles -%}
  --sut-scroll-distance: {{ scroll_distance }};
  --sut-vessel-color: {{ vessel_color }};
  padding-block-start: {{ section.settings['padding-block-start'] }}px;
  padding-block-end: {{ section.settings['padding-block-end'] }}px;
{%- endcapture -%}

<div
  class="story-universal-truth"
  data-section-id="{{ section.id }}"
  data-anchor="universal-truth"
  style="{{ inline_styles }}"
>
  <div class="story-universal-truth__scroll-track">
    <div class="story-universal-truth__sticky">

      {%- comment -%} Background decorative vessel network {%- endcomment -%}
      <svg
        class="story-universal-truth__bg-vessels"
        viewBox="0 0 1440 1000"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        <path d="M 310,300 C 360,390 410,350 490,440 C 570,530 540,580 590,680" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M 1090,280 C 1040,370 1000,340 940,430 C 880,520 910,570 860,660" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M 220,480 C 290,510 350,470 420,530 C 490,590 460,630 510,700" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M 1180,460 C 1120,500 1060,480 1000,540 C 940,600 970,640 920,710" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M 380,220 C 410,300 370,360 400,420" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1" stroke-linecap="round"/>
        <path d="M 1060,230 C 1030,310 1070,360 1040,420" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1" stroke-linecap="round"/>
      </svg>

      {%- comment -%} Inline SVG vessel with stroke-animated paths {%- endcomment -%}
      <svg
        class="story-universal-truth__vessel"
        viewBox="0 0 1440 1000"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        {%- comment -%} Stem enter: central line arriving from sub-nav {%- endcomment -%}
        <path
          class="story-universal-truth__vessel-path"
          data-phase="stem-enter"
          d="M 720 0 Q 718 60 720 122"
          fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"
        />

        {%- comment -%} Heartbeat squiggle: hand-drawn pulse motif {%- endcomment -%}
        <path
          class="story-universal-truth__vessel-path"
          data-phase="heartbeat"
          d="M 720,122 C 720,128 722,132 723,136 C 725,142 716,146 714,150 C 710,158 738,122 740,136 C 742,150 722,160 720,166 C 718,172 720,178 720,186"
          fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"
        />
        <path
          class="story-universal-truth__vessel-path"
          data-phase="heartbeat"
          d="M 721,126 C 721,132 719,138 718,144 C 716,152 724,146 726,154 C 728,162 718,166 719,174 C 720,180 720,184 720,188"
          fill="none" stroke="var(--sut-vessel-color)" stroke-width="1.5" stroke-linecap="round"
        />

        {%- comment -%} Stem mid: long vertical run down to the first bulb split {%- endcomment -%}
        <path
          class="story-universal-truth__vessel-path"
          data-phase="stem-mid"
          d="M 720 186 Q 721 265 720 344"
          fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"
        />

        {%- comment -%} Bulb 1 — vertical strands splitting from the stem, converging above the text {%- endcomment -%}
        <path class="story-universal-truth__vessel-path" data-phase="cage-1" d="M 720,344 L 720,508" fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-1" d="M 720,344 C 720,376 817,380 817,416 L 817,436 C 817,472 720,476 720,508" fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-1" d="M 720,344 C 720,376 623,380 623,416 L 623,436 C 623,472 720,476 720,508" fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-1" d="M 720,344 C 720,378 914,382 914,418 L 914,434 C 914,470 720,474 720,508" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1.5" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-1" d="M 720,344 C 720,378 526,382 526,418 L 526,434 C 526,470 720,474 720,508" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1.5" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-1" d="M 720,344 C 720,380 1011,384 1011,420 L 1011,432 C 1011,468 720,472 720,508" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1.25" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-1" d="M 720,344 C 720,380 429,384 429,420 L 429,432 C 429,468 720,472 720,508" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1.25" stroke-linecap="round"/>

        {%- comment -%} Bulb 2 — reopens below the text, converges into the exit stem {%- endcomment -%}
        <path class="story-universal-truth__vessel-path" data-phase="cage-2" d="M 720,695 L 720,905" fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-2" d="M 720,695 C 720,727 817,731 817,767 L 817,833 C 817,869 720,873 720,905" fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-2" d="M 720,695 C 720,727 623,731 623,767 L 623,833 C 623,869 720,873 720,905" fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-2" d="M 720,695 C 720,729 914,733 914,769 L 914,831 C 914,867 720,871 720,905" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1.5" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-2" d="M 720,695 C 720,729 526,733 526,769 L 526,831 C 526,867 720,871 720,905" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1.5" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-2" d="M 720,695 C 720,731 1011,735 1011,771 L 1011,829 C 1011,865 720,869 720,905" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1.25" stroke-linecap="round"/>
        <path class="story-universal-truth__vessel-path" data-phase="cage-2" d="M 720,695 C 720,731 429,735 429,771 L 429,829 C 429,865 720,869 720,905" fill="none" stroke="var(--sut-vessel-color)" stroke-width="1.25" stroke-linecap="round"/>

        {%- comment -%} Stem exit: continues downward to next chapter {%- endcomment -%}
        <path
          class="story-universal-truth__vessel-path"
          data-phase="stem-exit"
          d="M 720 905 Q 721 952 720 1000"
          fill="none" stroke="var(--sut-vessel-color)" stroke-width="2" stroke-linecap="round"
        />
      </svg>

      {%- comment -%} Text content layer {%- endcomment -%}
      <div class="story-universal-truth__content">
        {%- if eyebrow_text != blank -%}
          <span class="story-universal-truth__eyebrow">{{ eyebrow_text }}</span>
        {%- endif -%}

        <div class="story-universal-truth__text-block-1">
          {%- if text_block_1 != blank -%}
            <h2 class="story-universal-truth__heading">{{ text_block_1 }}</h2>
          {%- endif -%}
          {%- if supporting_line_1 != blank -%}
            <p class="story-universal-truth__supporting story-universal-truth__supporting-words">{{ supporting_line_1 }}</p>
          {%- endif -%}
        </div>

        <div class="story-universal-truth__text-block-2">
          {%- if text_block_2_eyebrow != blank -%}
            <span class="story-universal-truth__eyebrow-inline">{{ text_block_2_eyebrow }}</span>
          {%- endif -%}
          {%- if text_block_2 != blank -%}
            <div class="story-universal-truth__body">{{ text_block_2 }}</div>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</div>

<script type="module">
  (function () {
    const utilsUrl = {{ 'story-scroll-utils.js' | asset_url | json }};
    const sectionUrl = {{ 'story-universal-truth.js' | asset_url | json }};

    Promise.all([import(utilsUrl), import(sectionUrl)]).then(function ([utils, section]) {
      const sectionEl = document.querySelector('[data-section-id="{{ section.id }}"]');
      if (!sectionEl) return;
      section.init(sectionEl, utils);
    });
  })();
</script>

{% stylesheet %}
  /* ------------------------------------------------------------------ *\
     Universal Truth — .story-universal-truth
     Prefix: --sut-
  \* ------------------------------------------------------------------ */

  /* Background on the .shopify-section wrapper (avoids base.css .section trap) */
  .story-universal-truth-section {
    background-color: #6B6B6D;
    background-image: radial-gradient(130% 110% at 50% 30%, #87878A 0%, #707072 45%, #4E4E50 100%);
    position: relative;
    z-index: 1;
  }

  .story-universal-truth {
    position: relative;
  }

  /* Scroll track: tall container that drives the sticky pinning */
  .story-universal-truth__scroll-track {
    height: calc(var(--sut-scroll-distance, 5) * 100vh);
  }

  /* Sticky viewport: pins while the scroll track scrolls past */
  .story-universal-truth__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Background decorative vessel network */
  .story-universal-truth__bg-vessels {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
  }

  /* SVG vessel overlay */
  .story-universal-truth__vessel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  /* Text content layer */
  .story-universal-truth__content {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-rows: auto auto;
    justify-items: center;
    align-content: center;
    text-align: center;
    max-width: 800px;
    width: 100%;
    padding-inline: 24px;
    gap: 20px;
  }

  /* Eyebrow (grid row 1) */
  .story-universal-truth__eyebrow {
    grid-row: 1;
    grid-column: 1;
    font-family: "Uniforma Semibold", sans-serif;
    font-weight: 600;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: #FFFFFF;
    opacity: 0;
  }

  /* Text blocks stack in the same grid cell (row 2) */
  .story-universal-truth__text-block-1,
  .story-universal-truth__text-block-2 {
    grid-row: 2;
    grid-column: 1;
    will-change: transform, opacity;
  }

  /* Text block 1 */
  .story-universal-truth__text-block-1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .story-universal-truth__heading {
    font-family: "Stabil Grotesk Bold", sans-serif;
    font-weight: 700;
    font-size: 32px;
    line-height: 40px;
    letter-spacing: 0;
    color: #FFFFFF;
    margin: 0;
    opacity: 0;
    transform: scale(3.5);
    will-change: transform, opacity;
  }

  .story-universal-truth__heading em {
    font-style: normal;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .story-universal-truth__supporting {
    font-family: var(--font-heading--family), serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 30px;
    letter-spacing: -0.5px;
    color: #E4E4E2;
    margin: 0;
  }

  .story-universal-truth__word {
    display: inline;
    opacity: 0;
    will-change: opacity;
  }

  /* Text block 2 — nudged below viewport centre so it sits in the gap
     between the two vessel bulbs (bulb 1 converges above, bulb 2 opens below) */
  .story-universal-truth__text-block-2 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    opacity: 0;
    transform: scale(1.3);
    position: relative;
    top: 10svh;
  }

  .story-universal-truth__eyebrow-inline {
    font-family: "Uniforma Semibold", sans-serif;
    font-weight: 600;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: #FFFFFF;
  }

  .story-universal-truth__body {
    font-family: var(--font-heading--family), serif;
    font-weight: 400;
    font-size: 24px;
    line-height: 36px;
    letter-spacing: -0.5px;
    color: rgba(255, 255, 255, 0.72);
  }

  .story-universal-truth__body p {
    margin: 0;
  }

  .story-universal-truth__body strong {
    color: #FFFFFF;
    font-weight: 700;
  }

  /* ------ Mobile ------ */

  @media screen and (max-width: 749px) {
    .story-universal-truth__scroll-track {
      height: calc(var(--sut-scroll-distance, 5) * 60vh);
    }

    .story-universal-truth__content {
      max-width: 90vw;
      padding-inline: 16px;
    }

    .story-universal-truth__heading {
      font-size: 24px;
      line-height: 32px;
    }

    .story-universal-truth__supporting {
      font-size: 16px;
      line-height: 24px;
    }

    .story-universal-truth__body {
      font-size: 18px;
      line-height: 28px;
    }
  }

  /* ------ Reduced motion ------ */

  @media (prefers-reduced-motion: reduce) {
    .story-universal-truth__scroll-track {
      height: auto;
    }

    .story-universal-truth__sticky {
      position: relative;
      height: auto;
      min-height: 100vh;
      min-height: 100svh;
    }

    .story-universal-truth__eyebrow,
    .story-universal-truth__heading,
    .story-universal-truth__supporting,
    .story-universal-truth__text-block-1,
    .story-universal-truth__text-block-2,
    .story-universal-truth__word,
    .story-universal-truth__bg-vessels {
      opacity: 1 !important;
      transform: none !important;
    }

    .story-universal-truth__vessel-path {
      stroke-dashoffset: 0 !important;
    }

    .story-universal-truth__bg-vessels path {
      stroke-dashoffset: 0 !important;
    }

    .story-universal-truth__heading,
    .story-universal-truth__supporting,
    .story-universal-truth__text-block-1,
    .story-universal-truth__text-block-2,
    .story-universal-truth__word {
      will-change: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Universal truth",
  "class": "story-universal-truth-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "THE UNIVERSAL TRUTH"
    },
    {
      "type": "header",
      "content": "Text block 1"
    },
    {
      "type": "inline_richtext",
      "id": "text_block_1",
      "label": "Heading",
      "default": "America has been looking at cardiovascular health <em>all wrong.</em>"
    },
    {
      "type": "textarea",
      "id": "supporting_line_1",
      "label": "Supporting line",
      "default": "Some say it's about your heart problems. Or something you deal with in old age."
    },
    {
      "type": "header",
      "content": "Text block 2"
    },
    {
      "type": "text",
      "id": "text_block_2_eyebrow",
      "label": "Eyebrow",
      "default": "BUT THE REAL STORY ISN'T ABOUT THE HEART \u2014"
    },
    {
      "type": "richtext",
      "id": "text_block_2",
      "label": "Body",
      "default": "<p>It's about the <strong>60,000 miles of blood vessels</strong> doing the heavy lifting behind it. every second, <strong>for every one of us.</strong></p>"
    },
    {
      "type": "header",
      "content": "Vessel"
    },
    {
      "type": "color",
      "id": "vessel_color",
      "label": "Vessel color",
      "default": "#BC0F0F"
    },
    {
      "type": "header",
      "content": "Scroll distance"
    },
    {
      "type": "range",
      "id": "scroll_distance",
      "label": "Scroll distance",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5,
      "unit": "\u00d7vh"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    }
  ]
}
{% endschema %}
