    <div class="story-universal-truth__sticky">

      {%- comment -%} Background decorative vessel network {%- endcomment -%}
      <svg
        class="story-universal-truth__bg-vessels"
        viewBox="0 0 1440 1000"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        <path d="M 310,300 C 360,390 410,350 490,440 C 570,530 540,580 590,680" fill="none" stroke="#CACACA" stroke-width="1.5" stroke-linecap="round"/>
