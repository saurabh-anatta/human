

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<results-list
  class="section product-grid-container color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div
    class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
  >
    {% content_for 'block',
      type: 'filters',
      id: 'filters',
      results: collection,
      results_size: collection.products_count
    %}

    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate collection.products by products_per_page %}
      {% capture children %}
        {% for product in collection.products %}
          {% if section.settings.promo_1_position != blank and forloop.index == section.settings.promo_1_position and section.settings.promo_1_image != blank %}
            <li class="product-grid__item product-grid__item--promo" data-page="{{ paginate.current_page }}">
              {% render 'plp-promo-card',
                image: section.settings.promo_1_image,
                heading: section.settings.promo_1_heading,
                text: section.settings.promo_1_text,
                link_text: section.settings.promo_1_link_text,
                link_url: section.settings.promo_1_link_url
              %}
            </li>
          {% endif %}
          {% if section.settings.promo_2_position != blank and forloop.index == section.settings.promo_2_position and section.settings.promo_2_image != blank %}
            <li class="product-grid__item product-grid__item--promo" data-page="{{ paginate.current_page }}">
              {% render 'plp-promo-card',
                image: section.settings.promo_2_image,
                heading: section.settings.promo_2_heading,
                text: section.settings.promo_2_text,
                link_text: section.settings.promo_2_link_text,
                link_url: section.settings.promo_2_link_url
              %}
            </li>
          {% endif %}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item product-grid__item--{{ forloop.index0 }}"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            ref="cards[]"
          >
            {% # theme-check-disable %}
            {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
            {% # theme-check-enable %}
          </li>
        {% endfor %}
      {% endcapture %}

      {% render 'product-grid',
        section: section,
        children: children,
        products: collection.products,
        paginate: paginate,
        enable_infinite_scroll: section.settings.enable_infinite_scroll
      %}
    {% endpaginate %}
  </div>
</results-list>

{% style %}
  #shopify-section-{{ section.id }} .product-grid__item--promo {
    min-height: 534px;
  }

  #shopify-section-{{ section.id }} product-card .quick-add__button {
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .product-card__content {
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .product-card__content .rating-wrapper {
    padding-inline: 24px;
  }

  #shopify-section-{{ section.id }} .product-card__content .custom-liquid-block {
    padding-inline: 24px;
  }

  @media screen and (min-width: 750px) {
    /* When the vertical filter pane is hidden (drawer mode), the grid spans the full
       page width — the base.css offset rule still matches via the drawer sibling,
       which also carries .facets-block-wrapper--vertical, so override it here. */
    #shopify-section-{{ section.id }} .facets-block-wrapper--vertical.hidden ~ .main-collection-grid {
      grid-column: var(--grid-column--desktop);
    }
  }

  /* Fixed 3-column product grid per design */
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .product-grid--grid:not([product-grid-view='zoom-out']) {
      --product-grid-columns-desktop: repeat(3, 1fr);
    }
  }

  /* Fixed product image ratio to match design (Figma img frame: 426x310) */
  #shopify-section-{{ section.id }} product-card .card-gallery {
    --gallery-aspect-ratio: 426 / 310 !important;
  }

  /* Keep the full product visible inside the fixed-ratio frame (no cropping) */
  #shopify-section-{{ section.id }} product-card .card-gallery .product-media-container {
    --product-media-fit: contain !important;
  }

  /* Hide the floating quick-add icon over the image — replaced by the Quick View pill below */
  #shopify-section-{{ section.id }} product-card .card-gallery .quick-add {
    display: none;
  }

  /* Quick View pill in card content (Figma: red pill, pad 8/16, radius 28, #BC0F0F) */
  #shopify-section-{{ section.id }} .plp-quick-view .quick-add {
    position: static;
    inset: auto;
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .plp-quick-view .quick-add__product-form-component .shopify-product-form {
    justify-content: flex-start;
    align-items: flex-start;
  }

  /* Always use the "choose" button so the pill opens the quick view modal */
  #shopify-section-{{ section.id }} .plp-quick-view add-to-cart-component {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .plp-quick-view .quick-add__button--choose {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    position: static;
    opacity: 1;
    height: 32px;
    padding: 8px 16px;
    background: var(--color-brand-red, #bc0f0f);
    color: #ffffff;
    border: none;
    border-radius: 28px;
    backdrop-filter: none;
  }

  #shopify-section-{{ section.id }} .plp-quick-view .quick-add__button--choose .add-to-cart-text {
    display: none;
  }

  #shopify-section-{{ section.id }} .plp-quick-view .quick-add__button--choose::after {
    content: 'Quick View';
    font-family: var(--font-accent--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 16px;
    text-transform: uppercase;
    color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .product-grid__item--promo {
      min-height: 380px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Promotional cards"
    },
    {
      "type": "number",
      "id": "promo_1_position",
      "label": "Promo 1: before product #",
      "default": 3
    },
    {
      "type": "image_picker",
      "id": "promo_1_image",
      "label": "Promo 1: Image"
    },
    {
      "type": "text",
      "id": "promo_1_heading",
      "label": "Promo 1: Heading",
      "default": "Get 50% off our starter routine"
    },
    {
      "type": "text",
      "id": "promo_1_text",
      "label": "Promo 1: Description",
      "default": "#1 Doctor Recommended"
    },
    {
      "type": "text",
      "id": "promo_1_link_text",
      "label": "Promo 1: Link text",
      "default": "Shop the Routine"
    },
    {
      "type": "url",
      "id": "promo_1_link_url",
      "label": "Promo 1: Link URL"
    },
    {
      "type": "header",
      "content": "Promotional card 2"
    },
    {
      "type": "number",
      "id": "promo_2_position",
      "label": "Promo 2: before product #",
      "default": 7
    },
    {
      "type": "image_picker",
      "id": "promo_2_image",
      "label": "Promo 2: Image"
    },
    {
      "type": "text",
      "id": "promo_2_heading",
      "label": "Promo 2: Heading",
      "default": "Discover the Blood Pressure Science"
    },
    {
      "type": "text",
      "id": "promo_2_text",
      "label": "Promo 2: Description",
      "default": "How our ingredients deliver lasting benefit."
    },
    {
      "type": "text",
      "id": "promo_2_link_text",
      "label": "Promo 2: Link text",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "promo_2_link_url",
      "label": "Promo 2: Link URL"
    }
  ],
  "presets": []
}
{% endschema %}
