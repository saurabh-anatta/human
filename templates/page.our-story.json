    "story_universal_truth": {
      "type": "story-universal-truth",
      "settings": {
        "eyebrow_text": "THE UNIVERSAL TRUTH",
        "text_block_1": "America has been looking at cardiovascular health <em>all wrong.</em>",
        "supporting_line_1": "Some say it's about your heart problems. Or something you deal with in old age.",
        "text_block_2_eyebrow": "BUT THE REAL STORY ISN'T ABOUT THE HEART —",
        "text_block_2": "<p>It's about the <strong>60,000 miles of blood vessels</strong> doing the heavy lifting behind it. every second, <strong>for every one of us.</strong></p>",
        "vessel_color": "#BC0F0F",
        "scroll_distance": 5
      }
    },
    "story_the_problem": {
      "type": "story-the-problem",
      "blocks": {
