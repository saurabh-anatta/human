    "story_no_molecule": {
      "type": "story-no-molecule",
      "settings": {
        "headline_text": "<p>And at the center of it all is one thing you were never taught to think about: <strong>Nitric oxide.<\/strong><\/p>",
        "side_copy_serif": "<p>They call it the miracle molecule.<br>But scientists don\u2019t call it that lightly.<\/p>",
        "side_copy_bold": "<p>It is the most important molecule in your cardiovascular system.<\/p>",
        "hint_label": "scroll to reveal",
        "pin_distance": 4000,
        "overlap_distance": 5000,
        "fallback_image": "shopify://shop_images/screenshot-2026-07-18-at-9-24-21-am-1-full-page-vertical-poc-1440-wide-design-source-of-truth-for-the-whole-story-page-133281216.png"
      }
    },
    "story_blood_vessels": {
      "type": "story-blood-vessels",
      "settings": {
        "headline_text": "<p>Nitric Oxide keeps those 60,000 miles open, flowing\u2026 and <strong>alive.<\/strong><\/p>",
        "exit_copy_serif": "<p>We didn\u2019t discover it. But we did have the nerve to <strong>take the Nobel-winning science out of the lab<\/strong><\/p>",
        "exit_copy_bold": "<p>\u2014 and bring it to the people who needed it. That\u2019s where the revolution started.<\/p>",
        "hint_label": "scroll to reveal",
        "pin_distance": 5000,
        "overlap_distance": 5000,
        "fallback_image": "shopify://shop_images/screenshot-2026-07-17-at-4-43-38-pm-1-full-page-vertical-poc-1440-wide-design-source-of-truth-for-the-whole-story-page-133281133.png"
      },
      "blocks": {
        "narrative_1": {
          "type": "narrative_copy",
          "settings": {
            "enabled": false,
            "text": "<p>Your heart pumps 2,000 gallons \/ Through 100,000 beats<\/p>"
          }
        }
      },
      "block_order": ["narrative_1"]
    },
    "story_timeline": {
      "type": "story-timeline",
      "settings": {
        "pin_distance": 5000,
        "overlap_distance": 2000
      },
      "blocks": {
        "milestone_1998": {
          "type": "milestone",
          "settings": {
            "year_label": "1998",
            "subtitle": "nitric oxide discovery",
            "poster_image": "shopify://shop_images/e922a71812814f7aa98f510f5d105a6b-hd-1080p-3-3mbps-86402157-first10s-trimmed-1-full-page-vertical-poc-1440-wide-design-source-of-truth-for-the-whole-story-page-13328879.png",
            "caption_text": "<p>In 1998, the discovery of what nitric oxide does for the human body <strong>won the Nobel Prize in Medicine<\/strong> and was awarded to Dr. Ferid Murad, one of the scientists behind it.<\/p>"
          }
        },
        "milestone_2009": {
          "type": "milestone",
          "settings": {
            "year_label": "2009",
            "subtitle": "Our first product",
            "poster_image": "shopify://shop_images/beetelite-broll-only-1-full-page-vertical-poc-1440-wide-design-source-of-truth-for-the-whole-story-page-13328882.png",
            "caption_text": "<p>In 2009, that same discovery led to a nitric oxide research program at the University of Texas. <strong>And that\u2019s where Humann came to life.<\/strong><\/p>"
          }
        },
        "milestone_today": {
          "type": "milestone",
          "settings": {
            "year_label": "Today",
            "subtitle": "Millions of happy customers",
            "poster_image": "shopify://shop_images/humann-combined-product-only-no-text-v3-1-full-page-vertical-poc-1440-wide-design-source-of-truth-for-the-whole-story-page-13328885.png",
            "caption_text": "<p>Fifteen years later, the science hasn\u2019t changed. <strong>Our commitment to it hasn\u2019t either.<\/strong><\/p>"
          }
        }
      },
      "block_order": ["milestone_1998", "milestone_2009", "milestone_today"]
    },
    "story_molecule_in_all_of_us": {
      "type": "story-molecule-in-all-of-us",
      "settings": {
        "headline_text": "<p>Because the same molecule that started this <em>runs through all of us.<\/em><\/p>",
        "molecule_image": "shopify://shop_images/screenshot-2026-07-22-at-11-25-49-am-1-full-page-vertical-poc-1440-wide-design-source-of-truth-for-the-whole-story-page-13328907.png",
        "body_text": "<p>The same mechanism helping a 23-year-old athlete perform at their peak \u2014 and a 68-year-old keep a healthy blood pressure reading. One highway. Every kind of person running on it.<\/p>",
        "photo_1": "shopify://shop_images/kzabh10350-full-1-full-page-vertical-poc-1440-wide-design-source-of-truth-for-the-whole-story-page-13328902.jpg",
        "photo_2": "shopify://shop_images/kambria-trout-rdm2emlablm-unsplash-1-concept-14-out-diet-full-bleed-slide-final-design-125732198.jpg",
        "pin_distance": 4000,
        "overlap_distance": 5000
      }
